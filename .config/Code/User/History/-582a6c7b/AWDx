#!/bin/bash

# Harry's Custom Keyboard Layout Installation Script
# Installs programmer-friendly keyboard layout with macron support for Cosmic DE
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAYOUT_NAME="hb"
LAYOUT_DESCRIPTION="English (Harry)"

echo "=== Installing Harry's Custom Keyboard Layout ==="
echo "Location: $(basename "$SCRIPT_DIR")"
echo ""

# Check if running as root
if [[ $EUID -eq 0 ]]; then
    echo "❌ Please run this script as a regular user, it will use sudo when needed."
    exit 1
fi

# Check if symbols file exists
SYMBOLS_FILE="$SCRIPT_DIR/hb"
if [[ ! -f "$SYMBOLS_FILE" ]]; then
    echo "❌ Symbols file not found: $SYMBOLS_FILE"
    exit 1
fi

echo "✅ Found keyboard layout file"
echo ""

# Step 1: Install symbols file
echo "1️⃣  Installing keyboard symbols..."
sudo cp "$SYMBOLS_FILE" "/usr/share/X11/xkb/symbols/$LAYOUT_NAME"
sudo chmod 644 "/usr/share/X11/xkb/symbols/$LAYOUT_NAME"
echo "   ✅ Symbols file installed"
echo ""

# Step 2: Update XML rules files with proper formatting
echo "2️⃣  Updating XKB configuration files..."

update_xml_file() {
    local xml_file="$1"
    local temp_file=$(mktemp)
    
    if [[ ! -f "$xml_file" ]]; then
        echo "   ⚠️  Warning: $xml_file not found, skipping"
        return
    fi
    
    # Create backup
    sudo cp "$xml_file" "$xml_file.backup.$(date +%Y%m%d-%H%M%S)"
    
    # Remove any existing hb entries first
    sudo sed -i '/<name>hb<\/name>/,/<\/layout>/d' "$xml_file"
    
    # Find the layoutList opening tag and add our layout after it
    sudo awk -v layout_xml='    <layout>
      <configItem>
        <name>hb</name>
        <shortDescription>hb</shortDescription>
        <description>English (Harry)</description>
        <languageList>
          <iso639Id>eng</iso639Id>
        </languageList>
      </configItem>
    </layout>' '
    /<layoutList>/ {
        print $0
        print layout_xml
        next
    }
    {print}
    ' "$xml_file" > "$temp_file"
    
    sudo cp "$temp_file" "$xml_file"
    rm "$temp_file"
    
    echo "   ✅ Updated $(basename "$xml_file")"
}

update_xml_file "/usr/share/X11/xkb/rules/base.xml"
update_xml_file "/usr/share/X11/xkb/rules/evdev.xml"

echo ""

# Step 3: Clear XKB cache
echo "3️⃣  Refreshing XKB cache..."
sudo rm -rf /var/lib/xkb/* 2>/dev/null || true
# Also clear user cache if it exists
rm -rf ~/.cache/xkb/* 2>/dev/null || true
echo "   ✅ Cache cleared"
echo ""

# Step 4: Load the layout
echo "4️⃣  Activating keyboard layout..."
if setxkbmap -layout "$LAYOUT_NAME" 2>/dev/null; then
    echo "   ✅ Layout activated successfully!"
else
    echo "   ⚠️  Layout installed but may need manual activation"
fi

# Step 5: Verification
echo ""
echo "🔍 Verification:"
echo "   Current layout: $(setxkbmap -query 2>/dev/null | grep layout || echo 'Unknown (Wayland)')"
echo "   Symbols file: $(ls -la /usr/share/X11/xkb/symbols/$LAYOUT_NAME 2>/dev/null || echo 'Not found')"
echo ""

# Step 6: Set layout persistently (for some desktop environments)
echo "5️⃣  Attempting to set persistent layout..."
if command -v gsettings >/dev/null 2>&1; then
    # Try GNOME/Cosmic settings
    gsettings set org.gnome.desktop.input-sources sources "[('xkb', '$LAYOUT_NAME')]" 2>/dev/null && echo "   ✅ Set via gsettings" || echo "   ⚠️  gsettings failed (normal for some DEs)"
fi

if command -v localectl >/dev/null 2>&1; then
    # Try systemd localectl
    sudo localectl set-x11-keymap "$LAYOUT_NAME" 2>/dev/null && echo "   ✅ Set via localectl" || echo "   ⚠️  localectl failed"
fi

echo ""
echo "🎉 Installation Complete!"
echo ""
echo "📋 Layout Features:"
echo "   🔧 Programmer symbols: +[{(&=)]}*!\$ on number row"
echo "   🔤 Macron support: Alt + vowel (a,e,i,o,u) = ā,ē,ī,ō,ū"
echo "   🇳🇿 Perfect for coding and te reo Māori"
echo ""
echo "📝 How to activate:"
echo ""
echo "   Method 1 - Cosmic Settings:"
echo "   1. Open Settings → Desktop → Input → Keyboard"
echo "   2. Find 'English (Harry)' in the layout list"
echo "   3. Select it"
echo ""
echo "   Method 2 - Command line:"
echo "   setxkbmap -layout $LAYOUT_NAME"
echo ""
echo "   Method 3 - If not visible in settings:"
echo "   • Log out and back in"
echo "   • Restart desktop session"
echo "   • Reboot if necessary"
echo ""
echo "🚀 Happy coding!"