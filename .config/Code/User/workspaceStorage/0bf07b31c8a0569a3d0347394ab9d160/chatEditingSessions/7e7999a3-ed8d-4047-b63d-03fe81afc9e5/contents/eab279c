 as np\\n\\n# Create visualization\\nfig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(18, 12))\\n\\n# Shorten property names for display\\nshort_names = ['Waterloo Quay', 'Herd St', 'Kelburn Pde', 'Martin Sq', 'Theoretical']\\n\\n# 1. Price vs 2-Year Outcome\\ncolors_outcome = ['red' if val < 0 else 'green' for val in df['Outcome Value']]\\nax1.scatter(df['Asking Price'], df['Outcome Value'], s=200, c=colors_outcome, alpha=0.7, edgecolors='black', linewidth=2)\\nfor i, name in enumerate(short_names):\\n    ax1.annotate(name, (df['Asking Price'].iloc[i], df['Outcome Value'].iloc[i]), \\n                fontsize=9, ha='center', va='bottom', fontweight='bold')\\nax1.axhline(y=0, color='black', linestyle='--', linewidth=1.5, alpha=0.5)\\nax1.set_xlabel('Asking Price ($)', fontsize=11, fontweight='bold')\\nax1.set_ylabel('2-Year Outcome ($)', fontsize=11, fontweight='bold')\\nax1.set_title('Price vs 2-Year Wealth Outcome', fontsize=13, fontweight='bold')\\nax1.grid(True, alpha=0.3)\\nax1.text(0.02, 0.98, 'Green = Buy wins\\\\nRed = Rent wins', transform=ax1.transAxes, \\n        fontsize=10, va='top', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))\\n\\n# 2. Annual Costs Comparison\\nx_pos = np.arange(len(short_names))\\nbars1 = ax2.bar(x_pos, df['Body Corp (annual)'], label='Body Corp', color='#FF6B6B', alpha=0.8)\\nbars2 = ax2.bar(x_pos, df['Rates (annual)'], bottom=df['Body Corp (annual)'], \\n               label='Rates', color='#4ECDC4', alpha=0.8)\\nax2.set_xlabel('Property', fontsize=11, fontweight='bold')\\nax2.set_ylabel('Annual Cost ($)', fontsize=11, fontweight='bold')\\nax2.set_title('Annual Ownership Costs Breakdown', fontsize=13, fontweight='bold')\\nax2.set_xticks(x_pos)\\nax2.set_xticklabels(short_names, rotation=45, ha='right')\\nax2.legend()\\nax2.grid(True, alpha=0.3, axis='y')\\n\\n# Add total labels on bars\\nfor i, (bc, rates) in enumerate(zip(df['Body Corp (annual)'], df['Rates (annual)'])):\\n    total = bc + rates\\n    ax2.