'bold')\\n\\n# 3. 2-Year Outcome Bar Chart\\ncolors_bars = ['red' if val < 0 else 'green' for val in df['Outcome Value']]\\nbars = ax3.barh(short_names, df['Outcome Value'], color=colors_bars, alpha=0.7, edgecolor='black', linewidth=2)\\nax3.axvline(x=0, color='black', linestyle='--', linewidth=2)\\nax3.set_xlabel('Wealth Difference ($)', fontsize=11, fontweight='bold')\\nax3.set_title('2-Year Outcome: Buy vs Rent', fontsize=13, fontweight='bold')\\nax3.grid(True, alpha=0.3, axis='x')\\n\\n# Add value labels\\nfor i, val in enumerate(df['Outcome Value']):\\n    label = f'${abs(val):,.0f}'\\n    if val > 0:\\n        ax3.text(val + 500, i, label, va='center', ha='left', fontsize=10, fontweight='bold', color='darkgreen')\\n    else:\\n        ax3.text(val - 500, i, label, va='center', ha='right', fontsize=10, fontweight='bold', color='darkred')\\n\\n# 4. Price vs Annual Costs\\nscatter = ax4.scatter(df['Asking Price'], df['Total Annual Costs'], s=300, \\n                     c=df['Outcome Value'], cmap='RdYlGn', alpha=0.7, \\n                     edgecolors='black', linewidth=2, vmin=-30000, vmax=20000)\\nfor i, name in enumerate(short_names):\\n    ax4.annotate(name, (df['Asking Price'].iloc[i], df['Total Annual Costs'].iloc[i]), \\n                fontsize=9, ha='center', va='top', fontweight='bold')\\nax4.set_xlabel('Asking Price ($)', fontsize=11, fontweight='bold')\\nax4.set_ylabel('Total Annual Costs ($)', fontsize=11, fontweight='bold')\\nax4.set_title('Price vs Running Costs (colored by outcome)', fontsize=13, fontweight='bold')\\nax4.grid(True, alpha=0.3)\\ncbar = plt.colorbar(scatter, ax=ax4)\\ncbar.set_label('2yr Outcome ($)', fontsize=10)\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*90)\\nprint(\\\"VISUALIZATION INSIGHTS\\\")\\nprint(\\\"=\\\"*90)\\nprint(\\\"\\\\n📊 Top-Left: Higher prices don't guarantee better outcomes\\\")\\nprint(\\\"📊 Top-Right: Annual costs vary dramatically (3x difference!)\\\")\\nprint(\\\"📊 Bottom-Left: Martin Square has the best buy advantage despite mid-range price\\\")\\nprint(\\\"📊 Bottom-Right: Waterloo Quay has high costs AND favors renting - double whammy!\\\")\",\"internalMetadata\":{\"internalId\":\"c7c0190d\",\"runStartTimeAdjustment\":0,\"executionId\":\"09b9b52b-5ea4-4a1b-b77c-bde9ee0e95cb\",\"runStartTime\":1762141330492,\"runEndTime\":1762141331054,\"lastRunSuccess\":true,\"executionOrder\":114}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":115,\"id\":\"99217f6c\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"fcf61598-efa7-4989-ba98-4aab67d85b60\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Create a detailed ranking table\\nprint(\\\"=\\\"*90)\\nprint(\\\"PROPERTY RANKING BY 2-YEAR OUTCOME\\\")\\nprint(\\\"=\\\"*90)\\n\\n# Sort by outcome value (best to worst)\\ndf_ranked = df.sort_values('Outcome Value', ascending=False).reset_index(drop=True)\\ndf_ranked['Rank'] = range(1, len(df_ranked) + 1)\\n\\n# Create analysis columns\\ndf_ranked['Monthly Costs'] = (df_ranked['Body Corp (annual)'] + df_ranked['Rates (annual)']) / 12\\ndf_ranked['Cost %'] = (df_ranked['Total Annual Costs'] / df_ranked['Asking Price']) * 100\\n\\n# Display ranking\\nprint(\\\"\\\\n\\\")\\nfor idx, row in df_ranked.iterrows():\\n    rank_emoji = '🥇' if idx == 0 else '🥈' if idx == 1 else '🥉' if idx == 2 else '📍'\\n    \\n    print(f\\\"{rank_emoji} RANK #{row['Rank']}: {row['Property']}\\\")\\n    print(f\\\"   {'─'*70}\\\")\\n    print(f\\\"   Price: ${row['Asking Price']:,.0f} | 2yr Outcome: {row['2yr Outcome']}\\\")\\n    print(f\\\"   Monthly costs: ${row['Monthly Costs']:,.2f} ({row['Cost %']:.2f}% of price annually)\\\")\\n    \\n    if pd.notna(row['Bedrooms']):\\n        print(f\\\"   Bedrooms: {int(row['Bedrooms'])} | \\\", end='')\\n    if pd.notna(row['Floor Area (m²)']):\\n  