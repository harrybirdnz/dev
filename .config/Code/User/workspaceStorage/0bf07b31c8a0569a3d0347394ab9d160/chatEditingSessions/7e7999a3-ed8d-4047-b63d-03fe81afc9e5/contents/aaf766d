tle': ['Stratum in Leasehold', '', '', '', ''],\\n    '2yr Outcome': ['Rent by 30k', 'Buy by 4.3k', 'Buy by 7.7k', 'Buy by 19.7k', 'Buy by 7.5k']\\n}\\n\\ndf = pd.DataFrame(properties)\\n\\n# Display the comparison\\nprint(\\\"=\\\"*90)\\nprint(\\\"PROPERTY COMPARISON - 2 YEAR OUTLOOK\\\")\\nprint(\\\"=\\\"*90)\\nprint(\\\"\\\\nAssumptions:\\\")\\nprint(\\\"  - Infinite income capacity (can afford any mortgage)\\\")\\nprint(\\\"  - Difference between rent and house costs is invested\\\")\\nprint(\\\"  - Same investment return assumptions across all properties\\\")\\nprint(\\\"\\\\n\\\")\\n\\n# Format and display\\npd.set_option('display.max_columns', None)\\npd.set_option('display.width', None)\\npd.set_option('display.max_colwidth', None)\\nprint(df.to_string(index=False))\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*90)\\nprint(\\\"KEY INSIGHTS\\\")\\nprint(\\\"=\\\"*90)\\n\\n# Calculate metrics\\ndf['Monthly Cost'] = (df['Body Corp (annual)'] + df['Rates (annual)']) / 12\\ndf['Cost per m²'] = df.apply(lambda x: x['Total Annual Costs'] / x['Floor Area (m²)'] if pd.notna(x['Floor Area (m²)']) else None, axis=1)\\n\\nprint(f\\\"\\\\n📊 Price Range: ${df['Asking Price'].min():,.0f} - ${df['Asking Price'].max():,.0f}\\\")\\nprint(f\\\"   Median: ${df['Asking Price'].median():,.0f}\\\")\\n\\nprint(f\\\"\\\\n💰 Annual Costs Range: ${df['Total Annual Costs'].min():,.0f} - ${df['Total Annual Costs'].max():,.0f}\\\")\\nprint(f\\\"   Median: ${df['Total Annual Costs'].median():,.0f}\\\")\\n\\nprint(f\\\"\\\\n🏆 Best 2-Year Outcome: {df.loc[df['2yr Outcome'].str.contains('Buy by').fillna(False)].sort_values('2yr Outcome', ascending=False).iloc[0]['Property']}\\\")\\nprint(f\\\"   Result: {df.loc[df['2yr Outcome'].str.contains('Buy by').fillna(False)].sort_values('2yr Outcome', ascending=False).iloc[0]['2yr Outcome']}\\\")\\n\\nprint(f\\\"\\\\n⚠️  Worst 2-Year Outcome: {df.loc[df['2yr Outcome'].str.contains('Rent by').fillna(False)].iloc[0]['Property']}\\\")\\nprint(f\\\"   Result: {df.loc[df['2yr Outcome'].str.contains('Rent by').fillna(False)].iloc[0]['2yr Outcome']}\\\")\\n\\n# Extract numeric values from outcomes\\ndef extract_outcome_value(outcome_str):\\n    if 'Buy by' in outcome_str:\\n        return float(outcome_str.split('Buy by ')[1].replace('k', '')) * 1000\\n    elif 'Rent by' in outcome_str:\\n        return -float(outcome_str.split('Rent by ')[1].replace('k', '')) * 1000\\n    return 0\\n\\ndf['Outcome Value'] = df['2yr Outcome'].apply(extract_outcome_value)\\n\\nprint(f\\\"\\\\n📈 Range of outcomes: ${df['Outcome Value'].min():,.0f} to ${df['Outcome Value'].max():,.0f}\\\")\\nprint(f\\\"   Spread: ${df['Outcome Value'].max() - df['Outcome Value'].min():,.0f}\\\")\",\"internalMetadata\":{\"internalId\":\"565d0ec9\",\"runStartTimeAdjustment\":0,\"executionId\":\"393ed0f5-71fc-4aa8-af15-36809d3b692e\",\"runStartTime\":1762141330467,\"runEndTime\":1762141330483,\"lastRunSuccess\":true,\"executionOrder\":113,\"renderDuration\":{\"vscode.builtin-renderer\":1}}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":114,\"id\":\"e77bd5f6\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"fa2e0454-7da8-44b2-acc3-da35bcb8f556\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE4MDB4MTIwMCB3aXRoIDUgQXhlcz4=\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"a158926f-3e8b-4aff-a3a0-fea7b04d1c26\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"import matplotlib.pyplot as plt\\nimport numpy as np\\n\\n# Create visualization\\nfig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(18, 12