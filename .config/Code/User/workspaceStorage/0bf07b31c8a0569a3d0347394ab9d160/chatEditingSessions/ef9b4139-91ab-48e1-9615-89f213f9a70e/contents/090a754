["{\"transientOutputs\":false,\"transientCellMetadata\":{\"breakpointMargin\":true,\"id\":false,\"metadata\":false,\"attachments\":false},\"transientDocumentMetadata\":{\"cells\":true,\"indentAmount\":true},\"cellContentMetadata\":{\"attachments\":true}}","{\"cells\":[{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":20,\"id\":\"aa2cfd21\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"5206380e-687d-4eb6-8b9e-87a21f23f975\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# ============================================================================\\n# PROPERTY & FINANCIAL PARAMETERS - ADJUST THESE FOR DIFFERENT PROPERTIES\\n# ============================================================================\\n\\n# Property details\\nproperty_price = 580000         # Total property price\\ndeposit = 200000                 # Your deposit\\ninterest_rate = 4.85             # Annual interest rate (%)\\nloan_term_years = 30             # Loan term in years\\n\\n# Ongoing costs (annual)\\nrates_annual = 4552.99           # Council rates per year\\nbody_corp_annual = 6153.15      # Body corporate fees per year (0 if none)\\n\\n# Rent comparison\\nweekly_rent = 600                # What you'd pay in rent per week\\n\\n# Investment assumptions\\nproperty_growth_rate = 0.03      # Expected annual property appreciation (3%)\\ninvestment_return_rate = 0.05    # Expected return if deposit invested elsewhere (5%)\\n\\n# ============================================================================\\n# CALCULATED VALUES - DO NOT MODIFY\\n# ============================================================================\\n\\nP = property_price - deposit     # Loan principal\\nN = 12 * loan_term_years         # Loan term in months\\nr = (interest_rate / 100) / 12   # Monthly interest rate\\nc = (P * r) / (1 - (1 + r)**-N)  # Monthly repayment\\n\\nC = rates_annual + body_corp_annual  # Total annual ownership costs\\n\\nannual_rent = weekly_rent * 52\\nmonthly_rent = annual_rent / 12\\n\\n# Helper functions\\ndef principal_remaining(P, r, c, n):\\n    return P * (1 + r)**n - c * (((1 + r)**n - 1) / r)\\n\\ndef interest_paid(P, r, c, n):\\n    return (c * n) - (P - principal_remaining(P, r, c, n))\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"PROPERTY ANALYSIS SETUP\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\n📍 Property: ${property_price:,.0f}\\\")\\nprint(f\\\"   Deposit: ${deposit:,.0f} ({(deposit/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Loan: ${P:,.0f} ({(P/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Interest rate: {interest_rate}%\\\")\\nprint(f\\\"\\\\n💰 Monthly costs:\\\")\\nprint(f\\\"   Mortgage payment: ${c:,.2f}\\\")\\nprint(f\\\"   Ownership costs: ${C/12:,.2f}\\\")\\nprint(f\\\"   vs Rent: ${monthly_rent:,.2f}\\\")\\nprint(f\\\"\\\\n📈 Growth assumptions:\\\")\\nprint(f\\\"   Property: {property_growth_rate*100:.1f}% p.a.\\\")\\nprint(f\\\"   Investments: {investment_return_rate*100:.1f}% p.a.\\\")\",\"internalMetadata\":{\"executionId\":\"ec618b6d-74a7-4786-8123-097688a010c7\",\"runStartTime\":1762135165242,\"runEndTime\":1762135165244,\"lastRunSuccess\":true,\"executionOrder\":20,\"renderDuration\":{\"vscode.builtin-renderer\":2},\"runStartTimeAdjustment\":0,\"internalId\":\"f1796acb\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"b1d5e730\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Rent vs Buy Analysis\\n\\nCompare renting vs buying with a mortgage over different time periods.\\n\\nThe analysis considers:\\n- **Leverage effect:** Property appreciation on full value vs investment returns on deposit only\\n- **Opportunity cost:** Could invest the deposit elsewhere if renting\\n- **True costs:** Interest and ownership costs vs rent\\n- **Equity building:** Principal paydown creates wealth\",\"internalMetadata\":{\"internalId\":\"71e0aafc\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":22,\"id\":\"9e5dc628\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Core comparison function\\ndef complete_comparison(n_months, prop_growth=None, inv_return=None):\\n    \\\"\\\"\\\"\\n    Compare renting vs buying over n_months period.\\n    \\n    Returns detailed breakdown of both scenarios including leverage effects.\\n    \\\"\\\"\\\"\\n    if prop_growth is None:\\n        prop_growth = property_growth_rate\\n    if inv_return is None:\\n        inv_return = investment_return_rate\\n        \\n    years = n_months / 12\\n    \\n    # SCENARIO A: RENT + INVEST DEPOSIT\\n    total_rent = monthly_rent * n_months\\n    invested_deposit_value = deposit * (1 + inv_return) ** years\\n    investment_gains = invested_deposit_value - deposit\\n    \\n    # SCENARIO B: BUY WITH MORTGAGE\\n    total_interest = interest_paid(P, r, c, n_months)\\n    total_ownership_costs = C * (n_months / 12)\\n    \\n    property_future_value = property_price * (1 + prop_growth) ** years\\n    property_capital_gains = property_future_value - property_price\\n    remaining_loan = principal_remaining(P, r, c, n_months)\\n    equity = property_future_value - remaining_loan\\n    \\n    # NET WEALTH POSITIONS\\n    rent_net_wealth = invested_deposit_value - total_rent\\n    buy_net_wealth = equity - total_interest - total_ownership_costs\\n    \\n    wealth_difference = buy_net_wealth - rent_net_wealth\\n    \\n    return {\\n        'months': n_months,\\n        'years': years,\\n        # Rent scenario\\n        'total_rent': total_rent,\\n        'invested_deposit_value': invested_deposit_value,\\n        'investment_gains': investment_gains,\\n        'rent_net_wealth': rent_net_wealth,\\n        # Buy scenario  \\n        'total_interest': total_interest,\\n        'total_ownership_costs': total_ownership_costs,\\n        'property_future_value': property_future_value,\\n        'property_capital_gains': property_capital_gains,\\n        'remaining_loan': remaining_loan,\\n        'equity': equity,\\n        'buy_net_wealth': buy_net_wealth,\\n        # Comparison\\n        'wealth_difference': wealth_difference,\\n        'better_option': 'Buy' if wealth_difference > 0 else 'Rent'\\n    }\",\"internalMetadata\":{\"internalId\":\"5b9a7273\",\"runStartTimeAdjustment\":0,\"executionId\":\"50be025a-e512-47e6-82f7-a96b6fdfa230\",\"runStartTime\":1762135201863,\"runEndTime\":1762135201872,\"lastRunSuccess\":true,\"executionOrder\":22}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"3b9230d0\",\"metadata\":{}},\"outputs\":[],\"source\":\"## 2-Year Analysis: Tax-Free Exit in NZ\\n\\nAfter 2 years, you can sell tax-free in NZ (no CGT after bright-line test).\",\"internalMetadata\":{\"internalId\":\"ea290d3d\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":24,\"id\":\"65e3f7f9\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"e1642702-36d4-4a9d-b346-05fefb90259e\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# 2-year comparison\\nresult_2y = complete_comparison(24)\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"2-YEAR ANALYSIS (Tax-free exit in NZ)\\\")\\nprint(\\\"=\\\"*70)\\n\\nprint(f\\\"\\\\nSCENARIO A: RENT + INVEST ${deposit:,.0f}\\\")\\nprint(f\\\"  Rent paid: ${result_2y['total_rent']:,.2f}\\\")\\nprint(f\\\"  Deposit grows to: ${result_2y['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  Investment gains: ${result_2y['investment_gains']:,.2f}\\\")\\nprint(f\\\"  Net wealth: ${result_2y['rent_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(f\\\"SCENARIO B: BUY & SELL after 2 years\\\")\\nprint(f\\\"  Interest paid: ${result_2y['total_interest']:,.2f}\\\")\\nprint(f\\\"  Ownership costs: ${result_2y['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  Property value: ${result_2y['property_future_value']:,.2f}\\\")\\nprint(f\\\"  Capital gains: ${result_2y['property_capital_gains']:,.2f}\\\")\\nprint(f\\\"  Loan remaining: ${result_2y['remaining_loan']:,.2f}\\\")\\nprint(f\\\"  Equity: ${result_2y['equity']:,.2f}\\\")\\nprint(f\\\"  Net wealth: ${result_2y['buy_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(\\\"=\\\"*70)\\nif result_2y['wealth_difference'] > 0:\\n    print(f\\\"✓ BUYING is ${result_2y['wealth_difference']:,.2f} better!\\\")\\nelse:\\n    print(f\\\"✗ RENTING is ${-result_2y['wealth_difference']:,.2f} better\\\")\\n\\nprint(f\\\"\\\\nROI on ${deposit:,.0f}:\\\")\\nroi_rent = (result_2y['rent_net_wealth'] / deposit - 1) * 100\\nroi_buy = (result_2y['buy_net_wealth'] / deposit - 1) * 100\\nprint(f\\\"  Rent: {roi_rent:.1f}% ({roi_rent/2:.1f}% p.a.)\\\")\\nprint(f\\\"  Buy: {roi_buy:.1f}% ({roi_buy/2:.1f}% p.a.)\\\")\",\"internalMetadata\":{\"internalId\":\"e9523cb7\",\"runStartTimeAdjustment\":0,\"executionId\":\"da29c621-45c4-48f5-94cf-09720296dc20\",\"runStartTime\":1762135244142,\"runEndTime\":1762135244144,\"lastRunSuccess\":true,\"executionOrder\":24}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"341acfed\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Understanding the Numbers: Gross vs Net Wealth\\n\\nWhy isn't the advantage just (Equity - Invested Deposit)?\\n\\nBecause you had to **spend money** to build that equity!\",\"internalMetadata\":{\"internalId\":\"15f9df61\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"b3032e76\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Breaking down gross vs net\\nprint(\\\"=\\\"*70)\\nprint(\\\"GROSS vs NET WEALTH COMPARISON\\\")\\nprint(\\\"=\\\"*70)\\n\\ngross_difference = result_2y['equity'] - result_2y['invested_deposit_value']\\ncosts_difference = (result_2y['total_interest'] + result_2y['total_ownership_costs']) - result_2y['total_rent']\\n\\nprint(f\\\"\\\\n\\udcca GROSS WEALTH:\\\")\\nprint(f\\\"   Equity: ${result_2y['equity']:,.2f}\\\")\\nprint(f\\\"   vs Invested deposit: ${result_2y['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"   Gross difference: ${gross_difference:,.2f}\\\")\\n\\nprint(f\\\"\\\\n💸 COSTS PAID:\\\")\\nprint(f\\\"   Rent: ${result_2y['total_rent']:,.2f}\\\")\\nprint(f\\\"   Interest + Ownership: ${result_2y['total_interest'] + result_2y['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"   Extra costs to buy: ${costs_difference:,.2f}\\\")\\n\\nprint(f\\\"\\\\n✅ NET ADVANTAGE:\\\")\\nprint(f\\\"   ${gross_difference:,.2f} extra equity\\\")\\nprint(f\\\"   - ${costs_difference:,.2f} extra costs\\\")\\nprint(f\\\"   = ${result_2y['wealth_difference']:,.2f} net benefit\\\")\\n\\nprint(f\\\"\\\\n💡 You spent ${costs_difference:,.2f} extra to gain ${gross_difference:,.2f}\\\")\\nprint(f\\\"   That's a ${result_2y['wealth_difference']:,.2f} profit!\\\")\",\"internalMetadata\":{\"internalId\":\"a8bf3b55\",\"runStartTimeAdjustment\":0,\"executionId\":\"6ede6f61-fa5d-4970-8bda-5c931f34c498\",\"runStartTime\":1762135259465,\"executionOrder\":25}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"9eb53a57\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Visual Breakdown: Where Every Dollar Goes\",\"internalMetadata\":{\"internalId\":\"409780f4\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"5e3eb7f1\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"403d342a-9fc7-456f-bb14-0997b8f1876f\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE2MDB4NzAwIHdpdGggMiBBeGVzPg==\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"8485e12d-542c-447a-94e9-52b248329228\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"import matplotlib.pyplot as plt\\nimport numpy as np\\n\\n# Visualize the cash flows for 2-year analysis\\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\\n\\n# SCENARIO A: Rent + Invest\\nax1.set_title('SCENARIO A: Rent + Invest', fontsize=14, fontweight='bold')\\ncategories_a = ['Starting\\\\nCapital', 'Investment\\\\nGains', 'Rent\\\\nPaid', 'Final\\\\nPosition']\\nvalues_a = [deposit/1000, result_2y['investment_gains']/1000, \\n            -result_2y['total_rent']/1000, result_2y['rent_net_wealth']/1000]\\ncolors_a = ['blue', 'green', 'red', 'purple']\\n\\nbars_a = ax1.bar(categories_a, values_a, color=colors_a, alpha=0.7, edgecolor='black', linewidth=2)\\nax1.axhline(y=0, color='black', linewidth=0.5)\\nax1.set_ylabel('Amount ($1000s)', fontsize=12)\\nax1.grid(True, alpha=0.3, axis='y')\\n\\nfor i, bar in enumerate(bars_a):\\n    height = bar.get_height()\\n    label_y = height + 5 if height > 0 else height - 10\\n    ax1.text(bar.get_x() + bar.get_width()/2., label_y,\\n            f'${abs(height):.1f}k',\\n            ha='center', va='bottom' if height > 0 else 'top', \\n            fontsize=11, fontweight='bold')\\n\\n# Add flow arrows\\nax1.annotate('', xy=(1, deposit/1000), xytext=(0, deposit/1000),\\n            arrowprops=dict(arrowstyle='->', lw=2, color='green'))\\n\\n# SCENARIO B: Buy + Sell\\nax2.set_title('SCENARIO B: Buy + Sell', fontsize=14, fontweight='bold')\\ncategories_b = ['Equity\\\\nFrom Sale', 'Interest\\\\nPaid', 'Ownership\\\\nCosts', 'Final\\\\nPosition']\\nvalues_b = [result_2y['equity']/1000, -result_2y['total_interest']/1000,\\n            -result_2y['total_ownership_costs']/1000, result_2y['buy_net_wealth']/1000]\\ncolors_b = ['green', 'red', 'orange', 'purple']\\n\\nbars_b = ax2.bar(categories_b, values_b, color=colors_b, alpha=0.7, edgecolor='black', linewidth=2)\\nax2.axhline(y=0, color='black', linewidth=0.5)\\nax2.set_ylabel('Amount ($1000s)', fontsize=12)\\nax2.grid(True, alpha=0.3, axis='y')\\n\\nfor i, bar in enumerate(bars_b):\\n    height = bar.get_height()\\n    label_y = height + 5 if height > 0 else height - 10\\n    ax2.text(bar.get_x() + bar.get_width()/2., label_y,\\n            f'${abs(height):.1f}k',\\n            ha='center', va='bottom' if height > 0 else 'top', \\n            fontsize=11, fontweight='bold')\\n\\n# Add annotation showing the extra costs\\nextra_costs = (result_2y['total_interest'] + result_2y['total_ownership_costs'] - result_2y['total_rent']) / 1000\\nax2.annotate(f'Extra costs\\\\nvs renting:\\\\n${extra_costs:.1f}k', \\n            xy=(1.5, -40), fontsize=11, fontweight='bold', color='red',\\n            ha='center', bbox=dict(boxstyle='round,pad=0.5', facecolor='pink', alpha=0.7))\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nprint(\\\"RECONCILIATION\\\")\\nprint(\\\"=\\\"*70)\\nequity_k = result_2y['equity']/1000\\ninvested_k = result_2y['invested_deposit_value']/1000\\nprint(f\\\"\\\\nGross wealth difference:  ${equity_k:.1f}k - ${invested_k:.1f}k = ${gross_difference/1000:.1f}k\\\")\\nprint(f\\\"Minus extra costs paid:   ${costs_difference/1000:.1f}k\\\")\\nprint(f\\\"                          ─────────\\\")\\nprint(f\\\"Net benefit:              ${result_2y['wealth_difference']/1000:.1f}k\\\")\\nprint(f\\\"\\\\n✓ Your equity is ${gross_difference/1000:.1f}k higher\\\")\\nprint(f\\\"✓ But you paid ${costs_difference/1000:.1f}k extra to get it\\\")\\nprint(f\\\"✓ Net profit: ${result_2y['wealth_difference']/1000:.1f}k\\\")\",\"internalMetadata\":{\"internalId\":\"7fda82e8\",\"runStartTimeAdjustment\":0,\"executionId\":\"050460f8-adbb-496f-ac3c-1e87d751b17f\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"5a201d46\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Compounding: Repeating the 2-Year Strategy\\n\\nAfter 2 years, you have MORE capital to reinvest:\\n- **Rent scenario:** ${result_2y['invested_deposit_value']:,.0f}\\n- **Buy scenario:** ${result_2y['equity']:,.0f}\\n\\nThis advantage compounds if you repeat the strategy!\",\"internalMetadata\":{\"internalId\":\"4ffa3bde\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"e8cb2700\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"27e09f2a-b8a1-4e84-a32d-e9909c0a1fd7\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Simulate repeating the 2-year buy-sell strategy\\ndef simulate_repeated_strategy(num_cycles):\\n    \\\"\\\"\\\"Simulate repeating the 2-year buy-sell strategy multiple times.\\\"\\\"\\\"\\n    results = []\\n    \\n    rent_capital = deposit\\n    buy_capital = deposit\\n    \\n    for cycle in range(1, num_cycles + 1):\\n        years = cycle * 2\\n        \\n        # RENT: Compound investment and pay rent\\n        rent_capital_end = rent_capital * (1 + investment_return_rate) ** 2\\n        rent_paid = monthly_rent * 24\\n        rent_capital = rent_capital_end - rent_paid\\n        \\n        # BUY: Scale loan to maintain same LVR\\n        lvr = P / property_price\\n        scaled_property_price = buy_capital / (1 - lvr)\\n        scaled_loan = scaled_property_price * lvr\\n        \\n        # Calculate costs and appreciation\\n        scaled_interest = interest_paid(scaled_loan, r, c, 24)\\n        scaled_ownership = C * 2\\n        \\n        property_end_value = scaled_property_price * (1 + property_growth_rate) ** 2\\n        loan_remaining = principal_remaining(scaled_loan, r, c, 24)\\n        equity = property_end_value - loan_remaining\\n        \\n        buy_capital = equity - scaled_interest - scaled_ownership\\n        \\n        results.append({\\n            'cycle': cycle,\\n            'years': years,\\n            'rent_capital': rent_capital,\\n            'buy_capital': buy_capital,\\n            'difference': buy_capital - rent_capital\\n        })\\n    \\n    return results\\n\\n# Run 5 cycles (10 years)\\ncycles = simulate_repeated_strategy(5)\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"REPEATING THE 2-YEAR STRATEGY\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\nCycle | Years | Rent Capital | Buy Capital  | Advantage\\\")\\nprint(\\\"─\\\" * 70)\\n\\nfor r in cycles:\\n    pct = ((r['buy_capital']/r['rent_capital'] - 1)*100)\\n    print(f\\\"  {r['cycle']}   |   {r['years']}   | ${r['rent_capital']:>11,.0f} | ${r['buy_capital']:>11,.0f} | ${r['difference']:>9,.0f} ({pct:>5.1f}%)\\\")\\n\\nfinal = cycles[-1]\\nprint(f\\\"\\\\n💰 After {final['years']} years:\\\")\\nprint(f\\\"   Rent strategy: ${final['rent_capital']:,.0f}\\\")\\nprint(f\\\"   Buy-sell-repeat: ${final['buy_capital']:,.0f}\\\")\\nprint(f\\\"   You're ${final['difference']:,.0f} better off ({((final['buy_capital']/final['rent_capital']-1)*100):.1f}%!)\\\")\",\"internalMetadata\":{\"internalId\":\"565d0ec9\",\"runStartTimeAdjustment\":0,\"executionId\":\"2c70f58d-7496-46d3-aec0-3376b8c430fc\",\"runStartTime\":1762134172355,\"runEndTime\":1762134172359,\"lastRunSuccess\":true,\"executionOrder\":18,\"renderDuration\":{\"vscode.builtin-renderer\":2}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"1557bd9d\",\"metadata\":{}},\"outputs\":[],\"source\":\"### Visualizing the Compounding Effect\",\"internalMetadata\":{\"internalId\":\"c7c0190d\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"6f8d7f1c\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"da26719d-1ae8-49ed-a738-8dc84d085eec\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\"