["{\"transientOutputs\":false,\"transientCellMetadata\":{\"breakpointMargin\":true,\"id\":false,\"metadata\":false,\"attachments\":false},\"transientDocumentMetadata\":{\"cells\":true,\"indentAmount\":true},\"cellContentMetadata\":{\"attachments\":true}}","{\"cells\":[{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":5,\"id\":\"aa2cfd21\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"ca105af5-9da1-4123-b43a-e6d3da5b645b\",\"metadata\":{\"outputType\":\"execute_result\",\"executionCount\":5,\"metadata\":{}},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"NDM1MjUwLjE0NjA3NjYz\"},\"mime\":\"text/plain\"}]}],\"source\":\"deposit = 200000\\ninterest_rate = 4.85\\nP = 475000 # loan principal\\nN = 12*30 # loan term\\nr = (interest_rate / 100) / 12\\nc = (P * r) / (1 - (1 + r)**-N) # monthly repayment\\n\\nC = 4552.99 + 28001.45 # rates + body corp fees\\n\\ndef principal_remaining(P, r, c, n):\\n    return P * (1 + r)**n - c * (((1 + r)**n - 1) / r)\\ndef interest_paid(P, r, c, n):\\n    return (c * n) - (P - principal_remaining(P, r, c, n))\\ndef total_cost(deposit, C, c, N):\\n    return deposit + (C * (N / 12)) + (c * N)\\n\\n\",\"internalMetadata\":{\"executionId\":\"0a19c911-06b8-45ba-9851-b05952fc30fe\",\"runStartTime\":1762132422683,\"runEndTime\":1762132422685,\"lastRunSuccess\":true,\"executionOrder\":5,\"renderDuration\":{\"vscode.builtin-renderer\":0},\"runStartTimeAdjustment\":0,\"internalId\":\"f1796acb\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"b1d5e730\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Rent vs Mortgage Comparison\\n\\nCompare renting at $600/week vs buying with a mortgage.\\n\\n**Key Formula:**  \\nYou're better off buying if:  \\n`Rent Paid > (Interest Paid + Ownership Costs - Principal Paid Off)`\\n\\nOr equivalently, your **net cost** of ownership is less than rent.\",\"internalMetadata\":{\"internalId\":\"71e0aafc\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":6,\"id\":\"2c9d2aa5\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"1cfb7e54-d168-47b0-ab86-88e4fb3c33ad\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"V2Vla2x5IHJlbnQ6ICQ2MDAuMDAKTW9udGhseSByZW50OiAkMiw2MDAuMDAKQW5udWFsIHJlbnQ6ICQzMSwyMDAuMDAK\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Rent parameters\\nweekly_rent = 600\\nannual_rent = weekly_rent * 52\\nmonthly_rent = annual_rent / 12\\n\\nprint(f\\\"Weekly rent: ${weekly_rent:,.2f}\\\")\\nprint(f\\\"Monthly rent: ${monthly_rent:,.2f}\\\")\\nprint(f\\\"Annual rent: ${annual_rent:,.2f}\\\")\",\"internalMetadata\":{\"internalId\":\"9e56cdc5\",\"runStartTimeAdjustment\":0,\"executionId\":\"40e4630e-ebbe-4ba4-b28e-ffbe3d5c912f\",\"runStartTime\":1762132870848,\"runEndTime\":1762132870849,\"lastRunSuccess\":true,\"executionOrder\":6,\"renderDuration\":{\"vscode.builtin-renderer\":2}}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":7,\"id\":\"6a5b2acb\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Comparison function for any time period (in months)\\ndef compare_rent_vs_mortgage(n_months):\\n    \\\"\\\"\\\"\\n    Compare renting vs mortgage over n_months period.\\n    \\n    Returns:\\n    - Total rent paid\\n    - Total interest paid\\n    - Total ownership costs (rates + body corp)\\n    - Principal paid off\\n    - Net cost of ownership (interest + costs - principal)\\n    - Savings (positive means mortgage is better)\\n    \\\"\\\"\\\"\\n    # Rent\\n    total_rent = monthly_rent * n_months\\n    \\n    # Mortgage\\n    total_interest = interest_paid(P, r, c, n_months)\\n    total_ownership_costs = C * (n_months / 12)\\n    principal_paid = P - principal_remaining(P, r, c, n_months)\\n    \\n    # Net cost of owning vs renting\\n    net_ownership_cost = total_interest + total_ownership_costs - principal_paid\\n    savings = total_rent - net_ownership_cost\\n    \\n    return {\\n        'months': n_months,\\n        'years': n_months / 12,\\n        'total_rent': total_rent,\\n        'total_interest': total_interest,\\n        'total_ownership_costs': total_ownership_costs,\\n        'principal_paid': principal_paid,\\n        'net_ownership_cost': net_ownership_cost,\\n        'savings': savings,\\n        'better_option': 'Mortgage' if savings > 0 else 'Rent'\\n    }\",\"internalMetadata\":{\"internalId\":\"a51eb899\",\"runStartTimeAdjustment\":0,\"executionId\":\"585e7fdd-72ff-4cbc-82dd-6b69fcd21c1b\",\"runStartTime\":1762132873318,\"runEndTime\":1762132873320,\"lastRunSuccess\":true,\"executionOrder\":7}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"64813696\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Example Comparisons at Different Time Periods\",\"internalMetadata\":{\"internalId\":\"7f19b683\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":8,\"id\":\"1d359474\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"30e5ad12-6b32-4507-aee1-6ac959f4cda4\",\"metadata\":{\"outputType\":\"error\",\"originalError\":{\"output_type\":\"error\",\"ename\":\"ModuleNotFoundError\",\"evalue\":\"No module named 'pandas'\",\"traceback\":[\"\\u001b[31m---------------------------------------------------------------------------\\u001b[39m\",\"\\u001b[31mModuleNotFoundError\\u001b[39m                       Traceback (most recent call last)\",\"\\u001b[36mCell\\u001b[39m\\u001b[36m \\u001b[39m\\u001b[32mIn[8]\\u001b[39m\\u001b[32m, line 2\\u001b[39m\\n\\u001b[32m      1\\u001b[39m \\u001b[38;5;66;03m# Compare at different time periods\\u001b[39;00m\\n\\u001b[32m----> \\u001b[39m\\u001b[32m2\\u001b[39m \\u001b[38;5;28;01mimport\\u001b[39;00m\\u001b[38;5;250m \\u001b[39m\\u001b[34;01mpandas\\u001b[39;00m\\u001b[38;5;250m \\u001b[39m\\u001b[38;5;28;01mas\\u001b[39;00m\\u001b[38;5;250m \\u001b[39m\\u001b[34;01mpd\\u001b[39;00m\\n\\u001b[32m      4\\u001b[39m time_periods = [\\u001b[32m12\\u001b[39m, \\u001b[32m24\\u001b[39m, \\u001b[32m60\\u001b[39m, \\u001b[32m120\\u001b[39m, \\u001b[32m180\\u001b[39m, \\u001b[32m240\\u001b[39m, \\u001b[32m360\\u001b[39m]  \\u001b[38;5;66;03m# months (1, 2, 5, 10, 15, 20, 30 years)\\u001b[39;00m\\n\\u001b[32m      5\\u001b[39m results = [compare_rent_vs_mortgage(months) \\u001b[38;5;28;01mfor\\u001b[39;00m months \\u001b[38;5;129;01min\\u001b[39;00m time_periods]\\n\",\"\\u001b[31mModuleNotFoundError\\u001b[39m: No module named 'pandas'\"]}},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.error\"}]}],\"source\":\"# Compare at different time periods\\nimport pandas as pd\\n\\ntime_periods = [12, 24, 60, 120, 180, 240, 360]  # months (1, 2, 5, 10, 15, 20, 30 years)\\nresults = [compare_rent_vs_mortgage(months) for months in time_periods]\\n\\ndf = pd.DataFrame(results)\\ndf['savings'] = df['savings'].round(2)\\ndf['net_ownership_cost'] = df['net_ownership_cost'].round(2)\\ndf['total_rent'] = df['total_rent'].round(2)\\n\\n# Format for display\\npd.set_option('display.float_format', lambda x: f'${x:,.2f}' if abs(x) > 0.01 else '$0.00')\\nprint(df[['years', 'total_rent', 'net_ownership_cost', 'savings', 'better_option']].to_string(index=False))\\npd.reset_option('display.float_format')\",\"internalMetadata\":{\"internalId\":\"848ae00b\",\"runStartTimeAdjustment\":0,\"executionId\":\"a279ccf5-23d8-48ea-ada3-1ee8b6ec747b\",\"runStartTime\":1762132875847,\"runEndTime\":1762132875992,\"lastRunSuccess\":false,\"executionOrder\":8,\"renderDuration\":{\"vscode.builtin-renderer\":5},\"error\":{\"name\":\"ModuleNotFoundError\",\"message\":\"No module named 'pandas'\",\"stack\":\"\\u001b[31m---------------------------------------------------------------------------\\u001b[39m\\n\\u001b[31mModuleNotFoundError\\u001b[39m                       Traceback (most recent call last)\\n\\u001b[36mCell\\u