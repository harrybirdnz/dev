["{\"transientOutputs\":false,\"transientCellMetadata\":{\"breakpointMargin\":true,\"id\":false,\"metadata\":false,\"attachments\":false},\"transientDocumentMetadata\":{\"cells\":true,\"indentAmount\":true},\"cellContentMetadata\":{\"attachments\":true}}","{\"cells\":[{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"aa2cfd21\",\"metadata\":{}},\"outputs\":[],\"source\":\"# ============================================================================\\n# PROPERTY & FINANCIAL PARAMETERS - ADJUST THESE FOR DIFFERENT PROPERTIES\\n# ============================================================================\\n\\n# Property details\\nproperty_price = 580000         # Total property price\\ndeposit = 200000                 # Your deposit\\ninterest_rate = 4.85             # Annual interest rate (%)\\nloan_term_years = 30             # Loan term in years\\n\\n# Ongoing costs (annual)\\nrates_annual = 4552.99           # Council rates per year\\nbody_corp_annual = 28001.45      # Body corporate fees per year (0 if none)\\n\\n# Rent comparison\\nweekly_rent = 600                # What you'd pay in rent per week\\n\\n# Investment assumptions\\nproperty_growth_rate = 0.03      # Expected annual property appreciation (3%)\\ninvestment_return_rate = 0.05    # Expected return if deposit invested elsewhere (5%)\\n\\n# ============================================================================\\n# CALCULATED VALUES - DO NOT MODIFY\\n# ============================================================================\\n\\nP = property_price - deposit     # Loan principal\\nN = 12 * loan_term_years         # Loan term in months\\nr = (interest_rate / 100) / 12   # Monthly interest rate\\nc = (P * r) / (1 - (1 + r)**-N)  # Monthly repayment\\n\\nC = rates_annual + body_corp_annual  # Total annual ownership costs\\n\\nannual_rent = weekly_rent * 52\\nmonthly_rent = annual_rent / 12\\n\\n# Helper functions\\ndef principal_remaining(P, r, c, n):\\n    return P * (1 + r)**n - c * (((1 + r)**n - 1) / r)\\n\\ndef interest_paid(P, r, c, n):\\n    return (c * n) - (P - principal_remaining(P, r, c, n))\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"PROPERTY ANALYSIS SETUP\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\n📍 Property: ${property_price:,.0f}\\\")\\nprint(f\\\"   Deposit: ${deposit:,.0f} ({(deposit/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Loan: ${P:,.0f} ({(P/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Interest rate: {interest_rate}%\\\")\\nprint(f\\\"\\\\n💰 Monthly costs:\\\")\\nprint(f\\\"   Mortgage payment: ${c:,.2f}\\\")\\nprint(f\\\"   Ownership costs: ${C/12:,.2f}\\\")\\nprint(f\\\"   vs Rent: ${monthly_rent:,.2f}\\\")\\nprint(f\\\"\\\\n📈 Growth assumptions:\\\")\\nprint(f\\\"   Property: {property_growth_rate*100:.1f}% p.a.\\\")\\nprint(f\\\"   Investments: {investment_return_rate*100:.1f}% p.a.\\\")\",\"internalMetadata\":{\"executionId\":\"e229f510-ed49-4850-932d-9751a8690ce6\",\"runStartTime\":1762132894870,\"runEndTime\":1762132894871,\"lastRunSuccess\":true,\"executionOrder\":1,\"runStartTimeAdjustment\":0,\"internalId\":\"f1796acb\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"b1d5e730\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Rent vs Mortgage Comparison\\n\\nCompare renting at $600/week vs buying with a mortgage.\\n\\n**Key Formula:**  \\nYou're better off buying if:  \\n`Rent Paid > (Interest Paid + Ownership Costs - Principal Paid Off)`\\n\\nOr equivalently, your **net cost** of ownership is less than rent.\",\"internalMetadata\":{\"internalId\":\"71e0aafc\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":8,\"id\":\"9e5dc628\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"07766457-6044-465b-9f16-e397b740b61c\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Complete comparison with leverage and capital gains\\ndef complete_comparison(n_months, property_growth_rate=0.03, investment_return_rate=0.05):\\n    \\\"\\\"\\\"\\n    Full comparison including:\\n    - Rent vs ownership costs\\n    - Opportunity cost of deposit\\n    - Property capital gains (with leverage!)\\n    - Investment returns on deposit\\n    \\n    property_growth_rate: annual property appreciation rate\\n    investment_return_rate: annual return if deposit invested elsewhere\\n    \\\"\\\"\\\"\\n    basic = compare_rent_vs_mortgage(n_months)\\n    years = n_months / 12\\n    \\n    # Total property value (purchase price)\\n    property_value = deposit + P\\n    \\n    # SCENARIO A: RENT + INVEST DEPOSIT\\n    invested_deposit_value = deposit * (1 + investment_return_rate) ** years\\n    investment_gains = invested_deposit_value - deposit\\n    rent_scenario_wealth = invested_deposit_value  # Your wealth from investing\\n    rent_scenario_cost = basic['total_rent']\\n    \\n    # SCENARIO B: BUY WITH MORTGAGE\\n    property_future_value = property_value * (1 + property_growth_rate) ** years\\n    property_capital_gains = property_future_value - property_value\\n    remaining_loan = principal_remaining(P, r, c, n_months)\\n    equity = property_future_value - remaining_loan  # Property value minus what you owe\\n    \\n    buy_scenario_wealth = equity  # Your wealth in the property\\n    buy_scenario_cost = basic['total_interest'] + basic['total_ownership_costs']\\n    \\n    # NET COMPARISON\\n    # Scenario A: You have invested deposit, paid rent\\n    scenario_a_net = rent_scenario_wealth - rent_scenario_cost\\n    \\n    # Scenario B: You have equity in property, paid interest + costs\\n    scenario_b_net = buy_scenario_wealth - buy_scenario_cost\\n    \\n    wealth_difference = scenario_b_net - scenario_a_net\\n    \\n    return {\\n        'years': years,\\n        'property_growth_rate': property_growth_rate * 100,\\n        'investment_return_rate': investment_return_rate * 100,\\n        # Rent scenario\\n        'total_rent': rent_scenario_cost,\\n        'invested_deposit_value': invested_deposit_value,\\n        'investment_gains': investment_gains,\\n        'scenario_a_net_wealth': scenario_a_net,\\n        # Buy scenario\\n        'total_interest': basic['total_interest'],\\n        'total_ownership_costs': basic['total_ownership_costs'],\\n        'property_future_value': property_future_value,\\n        'property_capital_gains': property_capital_gains,\\n        'remaining_loan': remaining_loan,\\n        'equity': equity,\\n        'scenario_b_net_wealth': scenario_b_net,\\n        # Comparison\\n        'wealth_difference': wealth_difference,\\n        'better_option': 'Mortgage' if wealth_difference > 0 else 'Rent'\\n    }\\n\\n# Example with realistic rates\\nresult = complete_comparison(60, property_growth_rate=0.03, investment_return_rate=0.05)\\n\\nprint(f\\\"=== COMPLETE COMPARISON ({result['years']:.0f} years) ===\\\")\\nprint(f\\\"Property growth: {result['property_growth_rate']:.1f}% | Investment return: {result['investment_return_rate']:.1f}%\\\\n\\\")\\n\\nprint(f\\\"SCENARIO A: RENT + INVEST ${deposit:,.0f}\\\")\\nprint(f\\\"  Total rent paid: ${result['total_rent']:,.2f}\\\")\\nprint(f\\\"  Deposit grows to: ${result['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  Investment gains: ${result['investment_gains']:,.2f}\\\")\\nprint(f\\\"  ─────────────────────────────\\\")\\nprint(f\\\"  Net wealth position: ${result['scenario_a_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(f\\\"SCENARIO B: BUY WITH MORTGAGE\\\")\\nprint(f\\\"  Interest paid: ${result['total_interest']:,.2f}\\\")\\nprint(f\\\"  Ownership costs: ${result['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  Property value: ${result['property_future_value']:,.2f}\\\")\\nprint(f\\\"  Capital gains: ${result['property_capital_gains']:,.2f}\\\")\\nprint(f\\\"  Remaining loan: ${result['remaining_loan']:,.2f}\\\")\\nprint(f\\\"  Your equity: ${result['equity']:,.2f}\\\")\\nprint(f\\\"  ─────────────────────────────\\\")\\nprint(f\\\"  Net wealth position: ${result['scenario_b_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(f\\\"RESULT:\\\")\\nif result['wealth_difference'] > 0:\\n    print(f\\\"  ✓ BUYING is better by ${result['wealth_difference']:,.2f}\\\")\\n    print(f\\\"    You end up ${result['wealth_difference']:,.2f} wealthier by buying!\\\")\\nelse:\\n    print(f\\\"  ✗ RENTING is better by ${-result['wealth_difference']:,.2f}\\\")\\n    print(f\\\"    You end up ${-result['wealth_difference']:,.2f} wealthier by renting!\\\")\\n    \\nprint(f\\\"\\\\n💡 The leverage effect: Your ${deposit:,.0f} deposit controls a ${deposit + P:,.0f} property!\\\")\\nprint(f\\\"   Property gains: ${result['property_capital_gains']:,.2f} vs Investment gains: ${result['investment_gains']:,.2f}\\\")\",\"internalMetadata\":{\"internalId\":\"5b9a7273\",\"runStartTimeAdjustment\":0,\"executionId\":\"3a1ed9f3-8ae9-45bc-9350-a5f790fe29c7\",\"runStartTime\":1762132974167,\"runEndTime\":1762132974172,\"lastRunSuccess\":true,\"executionOrder\":8,\"renderDuration\":{\"vscode.builtin-renderer\":2}}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":11,\"id\":\"b2bf9deb\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"f934cbd1-da8a-4a0f-96ee-0a0865204410\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE0MDB4MTAwMCB3aXRoIDIgQXhlcz4=\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"03f88062-de9d-4b29-ac89-fe5a26a2ed64\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"import matplotlib.pyplot as plt\\nimport numpy as np\\n\\n# Generate data for every month over 30 years\\nmonths_range = range(1, 361)  # 1 to 360 months (30 years)\\n\\n# Calculate wealth difference with and without waiver\\nwealth_diff_with_waiver = []\\nwealth_diff_without_waiver = []\\n\\nfor month in months_range:\\n    result_with = complete_comparison_with_waiver(month, 0.03, 0.05, waiver_months=12)\\n    result_without = complete_comparison(month, 0.03, 0.05)\\n    wealth_diff_with_waiver.append(result_with['wealth_difference'])\\n    wealth_diff_without_waiver.append(result_without['wealth_difference'])\\n\\n# Convert to numpy arrays and years\\nmonths_array = np.array(months_range)\\nyears_array = months_array / 12\\nwealth_with = np.array(wealth_diff_with_waiver)\\nwealth_without = np.array(wealth_diff_without_waiver)\\n\\n# Create the plot\\nfig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))\\n\\n# Plot 1: Wealth difference over time\\nax1.plot(years_array, wealth_with / 1000, label='With Body Corp Waiver (Year 1)', linewidth=2, color='green')\\nax1.plot(years_array, wealth_without / 1000, label='Without Waiver', linewidth=2, color='blue', linestyle='--')\\nax1.axhline(y=0, color='black', linestyle='-', linewidth=0.5, alpha=0.3)\\nax1.fill_between(years_array, 0, wealth_with / 1000, where=(wealth_with > 0), alpha=0.2, color='green', label='Mortgage Better')\\nax1.fill_between(years_array, 0, wealth_with / 1000, where=(wealth_with < 0), alpha=0.2, color='red', label='Rent Better')\\n\\nax1.set_xlabel('Years', fontsize=12)\\nax1.set_ylabel('Wealth Difference ($1000s)', fontsize=12)\\nax1.set_title('Rent vs Mortgage: Net Wealth Difference Over Time\\\\n(Positive = Mortgage Better, Negative = Rent Better)', fontsize=14, fontweight='bold')\\nax1.legend(loc='best', fontsize=10)\\nax1.grid(True, alpha=0.3)\\n\\n# Add annotations for crossover points (where line crosses zero)\\ncrossovers = []\\nfor i in range(1, len(wealth_with)):\\n    if (wealth_with[i-1] < 0 and wealth_with[i] >= 0) or (wealth_with[i-1] >= 0 and wealth_with[i] < 0):\\n        crossovers.append(years_array[i])\\n\\nfor crossover in crossovers[:3]:  # Show first 3 crossovers\\n    ax1.axvline(x=crossover, color='orange', linestyle=':', alpha=0.5)\\n    ax1.text(crossover, ax1.get_ylim()[1] * 0.9, f'{crossover:.1f}y', \\n             rotation=90, verticalalignment='top', fontsize=9, color='orange')\\n\\n# Plot 2: Comparison of both scenarios (zoomed to first 10 years)\\nax2.plot(years_array, wealth_with / 1000, label='With Waiver', linewidth=2, color='green')\\nax2.plot(years_array, wealth_without / 1000, label='Without Waiver', linewidth=2, color='blue', linestyle='--')\\nax2.axhline(y=0, color='black', linestyle='-', linewidth=0.5, alpha=0.3)\\nax2.set_xlim(0, 10)\\nax2.set_xlabel('Years', fontsize=12)\\nax2.set_ylabel('Wealth Difference ($1000s)', fontsize=12)\\nax2.set_title('First 10 Years Detail View', fontsize=14, fontweight='bold')\\nax2.legend(loc='best', fontsize=10)\\nax2.grid(True, alpha=0.3)\\n\\nplt.tight_layout()\\nplt.show()\\n\\n# Print crossover points\\nprint(\\\"\\\\n=== CROSSOVER POINTS (where mortgage becomes better/worse than rent) ===\\\")\\nprint(f\\\"With waiver, crossovers at: {[f'{x:.1f} years' for x in crossovers]}\\\")\\nif crossovers:\\n    print(f\\\"\\\\nInterpretation:\\\")\\n    if len(crossovers) >= 1:\\n        print(f\\\"  • 0-{crossovers[0]:.1f} years: Mortgage is better\\\")\\n    if len(crossovers) >= 2:\\n        print(f\\\"  • {crossovers[0]:.1f}-{crossovers[1]:.1f} years: Rent is better\\\") \\n    if len(crossovers) >= 2:\\n        print(f\\\"  • After {crossovers[1]:.1f} years: Mortgage is better again\\\")\",\"internalMetadata\":{\"internalId\":\"9c19b1c3\",\"runStartTimeAdjustment\":0,\"executionId\":\"8e7214b8-2b64-4292-8ca0-ebc17af87ce6\",\"runStartTime\":1762133176477,\"runEndTime\":1762133177274,\"lastRunSuccess\":true,\"executionOrder\":11,\"renderDuration\":{\"vscode.builtin-renderer\":1}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"2da1ba2b\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Breaking Down the Components\",\"internalMetadata\":{\"internalId\":\"8c8f1c85\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":12,\"id\":\"92b25f55\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"01aedd36-e9b0-4d34-aa31-aa6fa0944c6b\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE2MDB4MTAwMCB3aXRoIDQgQXhlcz4=\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"5beb4f75-0ba4-4cc7-9048-b0538540eac8\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Visualize the components that drive the comparison\\nfig, axes = plt.subplots(2, 2, figsize=(16, 10))\\n\\n# Collect component data\\nsample_months = [12, 60, 120, 180, 240, 300, 360]\\nresults_breakdown = [complete_comparison_with_waiver(m, 0.03, 0.05) for m in sample_months]\\nyears_sample = [r['years'] for r in results_breakdown]\\n\\n# Plot 1: Costs\\nax = axes[0, 0]\\nrent_costs = [r['total_rent'] / 1000 for r in results_breakdown]\\ninterest_costs = [r['total_interest'] / 1000 for r in results_breakdown]\\nownership_costs = [r['total_ownership_costs'] / 1000 for r in results_breakdown]\\ntotal_buy_costs = [interest_costs[i] + ownership_costs[i] for i in range(len(interest_costs))]\\n\\nx = np.arange(len(years_sample))\\nwidth = 0.35\\n\\nbars1 = ax.bar(x - width/2, rent_costs, width, label='Rent Costs', color='orange')\\nbars2 = ax.bar(x + width/2, total_buy_costs, width, label='Buy Costs (Interest + Ownership)', color='brown')\\n\\nax.set_xlabel('Years', fontsize=11)\\nax.set_ylabel('Total Costs ($1000s)', fontsize=11)\\nax.set_title('Total Costs Comparison', fontsize=12, fontweight='bold')\\nax.set_xticks(x)\\nax.set_xticklabels([f'{y:.0f}' for y in years_sample])\\nax.legend()\\nax.grid(True, alpha=0.3, axis='y')\\n\\n# Plot 2: Gains (Investment vs Property)\\nax = axes[0, 1]\\ninvestment_gains = [r['investment_gains'] / 1000 for r in results_breakdown]\\nproperty_gains = [r['property_capital_gains'] / 1000 for r in results_breakdown]\\n\\nbars1 = ax.bar(x - width/2, investment_gains, width, label='Investment Gains (5%)', color='lightblue')\\nbars2 = ax.bar(x + width/2, property_gains, width, label='Property Capital Gains (3%)', color='lightgreen')\\n\\nax.set_xlabel('Years', fontsize=11)\\nax.set_ylabel('Capital Gains ($1000s)', fontsize=11)\\nax.set_title('Leverage Effect: Investment vs Property Gains', fontsize=12, fontweight='bold')\\nax.set_xticks(x)\\nax.set_xticklabels([f'{y:.0f}' for y in years_sample])\\nax.legend()\\nax.grid(True, alpha=0.3, axis='y')\\n\\n# Plot 3: Equity Growth\\nax = axes[1, 0]\\nequity = [r['equity'] / 1000 for r in results_breakdown]\\nprincipal_paid = [(deposit + P - r['remaining_loan']) / 1000 for r in results_breakdown]\\n\\nax.plot(years_sample, equity, marker='o', linewidth=2, label='Total Equity (Value - Loan)', color='green')\\nax.plot(years_sample, principal_paid, marker='s', linewidth=2, label='Amount Paid (Deposit + Principal)', color='blue', linestyle='--')\\nax.fill_between(years_sample, principal_paid, equity, alpha=0.3, color='green', label='Capital Gains Component')\\n\\nax.set_xlabel('Years', fontsize=11)\\nax.set_ylabel('Equity ($1000s)', fontsize=11)\\nax.set_title('Equity Growth in Property', fontsize=12, fontweight='bold')\\nax.legend()\\nax.grid(True, alpha=0.3)\\n\\n# Plot 4: Net Wealth Position\\nax = axes[1, 1]\\nrent_wealth = [r['scenario_a_net_wealth'] / 1000 for r in results_breakdown]\\nbuy_wealth = [r['scenario_b_net_wealth'] / 1000 for r in results_breakdown]\\n\\nax.plot(years_sample, rent_wealth, marker='o', linewidth=2, label='Rent + Invest', color='orange')\\nax.plot(years_sample, buy_wealth, marker='s', linewidth=2, label='Buy with Mortgage', color='green')\\n\\nax.set_xlabel('Years', fontsize=11)\\nax.set_ylabel('Net Wealth Position ($1000s)', fontsize=11)\\nax.set_title('Final Wealth Position Comparison', fontsize=12, fontweight='bold')\\nax.legend()\\nax.grid(True, alpha=0.3)\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n💡 Key Observations:\\\")\\nprint(\\\"   • Top-left: Rent costs grow linearly, buy costs too (but different rate)\\\")\\nprint(\\\"   • Top-right: Property gains MUCH larger than investment gains due to leverage\\\")\\nprint(\\\"   • Bottom-left: Your equity grows from capital gains AND principal paydown\\\")\\nprint(\\\"   • Bottom-right: Net wealth shows which scenario leaves you better off\\\")\",\"internalMetadata\":{\"internalId\":\"02bf5da3\",\"runStartTimeAdjustment\":0,\"executionId\":\"b48c9e03-7f41-4624-a211-2ecdfb66e039\",\"runStartTime\":1762133273010,\"runEndTime\":1762133273494,\"lastRunSuccess\":true,\"executionOrder\":12,\"renderDuration\":{\"vscode.builtin-renderer\":1}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"3b9230d0\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Optimal Exit Strategy: 2-Year Hold\\n\\nBased on NZ tax rules (no capital gains tax after 2 years), let's analyze selling after exactly 2 years when:\\n1. You've had the body corp waiver benefit for year 1\\n2. You've avoided the worst of the \\\"body corp penalty\\\" period (2-6 years)\\n3. You're past the 2-year CGT threshold\",\"internalMetadata\":{\"internalId\":\"ea290d3d\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":13,\"id\":\"65e3f7f9\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"b9224e75-6696-419b-92b8-a01c2c6f718a\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Detailed 2-year exit analysis\\ntwo_year_result = complete_comparison_with_waiver(24, 0.03, 0.05, waiver_months=12)\\n\\nprint(\\\"=== 2-YEAR EXIT STRATEGY ANALYSIS ===\\\\n\\\")\\nprint(\\\"SCENARIO A: RENT for 2 years + INVEST $200k\\\")\\nprint(f\\\"  Total rent paid: ${two_year_result['total_rent']:,.2f}\\\")\\nprint(f\\\"  Deposit invested grows to: ${two_year_result['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  Investment gains: ${two_year_result['investment_gains']:,.2f}\\\")\\nprint(f\\\"  Net wealth position: ${two_year_result['scenario_a_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(\\\"SCENARIO B: BUY, hold 2 years, SELL (no CGT!)\\\")\\nprint(f\\\"  Interest paid: ${two_year_result['total_interest']:,.2f}\\\")\\nprint(f\\\"  Ownership costs (Year 1 waived): ${two_year_result['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  Property appreciated to: ${two_year_result['property_future_value']:,.2f}\\\")\\nprint(f\\\"  Capital gains (tax-free!): ${two_year_result['property_capital_gains']:,.2f}\\\")\\nprint(f\\\"  Loan remaining: ${two_year_result['remaining_loan']:,.2f}\\\")\\nprint(f\\\"  Your equity after sale: ${two_year_result['equity']:,.2f}\\\")\\nprint(f\\\"  Net wealth position: ${two_year_result['scenario_b_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(\\\"=\\\" * 60)\\nprint(f\\\"WEALTH DIFFERENCE: ${two_year_result['wealth_difference']:,.2f}\\\")\\nif two_year_result['wealth_difference'] > 0:\\n    print(f\\\"✓ BUYING and selling after 2 years leaves you ${two_year_result['wealth_difference']:,.2f} BETTER OFF!\\\")\\nelse:\\n    print(f\\\"✗ Renting would leave you ${-two_year_result['wealth_difference']:,.2f} better off\\\")\\n\\n# Break down the wealth position more clearly\\nprint(f\\\"\\\\n📊 WHERE YOUR MONEY GOES:\\\\n\\\")\\nprint(\\\"If you RENT:\\\")\\nprint(f\\\"  Starting capital: ${deposit:,.2f}\\\")\\nprint(f\\\"  + Investment gains: ${two_year_result['investment_gains']:,.2f}\\\")\\nprint(f\\\"  - Rent paid: -${two_year_result['total_rent']:,.2f}\\\")\\nprint(f\\\"  = Final position: ${two_year_result['scenario_a_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(\\\"If you BUY & SELL after 2 years:\\\")\\nprint(f\\\"  Property sale proceeds: ${two_year_result['property_future_value']:,.2f}\\\")\\nprint(f\\\"  - Pay off loan: -${two_year_result['remaining_loan']:,.2f}\\\")\\nprint(f\\\"  = Cash in hand: ${two_year_result['equity']:,.2f}\\\")\\nprint(f\\\"  - Interest paid: -${two_year_result['total_interest']:,.2f}\\\")\\nprint(f\\\"  - Ownership costs: -${two_year_result['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  = Final position: ${two_year_result['scenario_b_net_wealth']:,.2f}\\\\n\\\")\\n\\n# Calculate ROI on the deposit\\nroi_rent = (two_year_result['scenario_a_net_wealth'] / deposit) * 100\\nroi_buy = (two_year_result['scenario_b_net_wealth'] / deposit) * 100\\n\\nprint(f\\\"📈 RETURN ON YOUR $200K:\\\")\\nprint(f\\\"  Rent + Invest: {roi_rent:.1f}% over 2 years ({roi_rent/2:.1f}% p.a.)\\\")\\nprint(f\\\"  Buy + Sell: {roi_buy:.1f}% over 2 years ({roi_buy/2:.1f}% p.a.)\\\")\\nprint(f\\\"  Difference: {roi_buy - roi_rent:.1f} percentage points better!\\\")\",\"internalMetadata\":{\"internalId\":\"e9523cb7\",\"runStartTimeAdjustment\":0,\"executionId\":\"22bc123f-1470-4dae-9a99-1641f4693e68\",\"runStartTime\":1762133380479,\"runEndTime\":1762133380481,\"lastRunSuccess\":true,\"executionOrder\":13,\"renderDuration\":{\"vscode.builtin-renderer\":5}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"341acfed\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Understanding the Math: Why It's Not Just Equity - Investment?\\n\\n**Your question: If I have $255k equity vs $220k invested, why am I only $15k better off, not $35k?**\\n\\nThe answer: You had to **spend money** to build that equity!\",\"internalMetadata\":{\"internalId\":\"15f9df61\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":16,\"id\":\"b3032e76\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"793ba2cc-8c4c-42e8-a6a9-411ce65ae495\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Breaking down the apparent discrepancy\\nprint(\\\"=\\\"*70)\\nprint(\\\"WHY ISN'T IT JUST $255k - $220k = $35k BETTER OFF?\\\")\\nprint(\\\"=\\\"*70)\\n\\nprint(\\\"\\\\n📍 SCENARIO A: RENT + INVEST\\\")\\nprint(f\\\"   Starting capital: ${deposit:,.2f}\\\")\\nprint(f\\\"   Grows to: ${two_year_result['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"   BUT you also paid: ${two_year_result['total_rent']:,.2f} in rent\\\")\\nprint(f\\\"   ─────────────────────────────\\\")\\nprint(f\\\"   Net position: ${two_year_result['invested_deposit_value']:,.2f} - ${two_year_result['total_rent']:,.2f}\\\")\\nprint(f\\\"               = ${two_year_result['scenario_a_net_wealth']:,.2f}\\\")\\n\\nprint(\\\"\\\\n📍 SCENARIO B: BUY + SELL\\\")\\nprint(f\\\"   Equity after sale: ${two_year_result['equity']:,.2f}\\\")\\nprint(f\\\"   BUT you also paid: ${two_year_result['total_interest']:,.2f} in interest\\\")\\nprint(f\\\"                    + ${two_year_result['total_ownership_costs']:,.2f} in ownership costs\\\")\\nprint(f\\\"   ─────────────────────────────\\\")\\nprint(f\\\"   Net position: ${two_year_result['equity']:,.2f} - ${two_year_result['total_interest']:,.2f} - ${two_year_result['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"               = ${two_year_result['scenario_b_net_wealth']:,.2f}\\\")\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nprint(\\\"THE COMPARISON:\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"Scenario A net: ${two_year_result['scenario_a_net_wealth']:,.2f}\\\")\\nprint(f\\\"Scenario B net: ${two_year_result['scenario_b_net_wealth']:,.2f}\\\")\\nprint(f\\\"Difference:     ${two_year_result['wealth_difference']:,.2f}\\\")\\n\\nprint(\\\"\\\\n💡 KEY INSIGHT:\\\")\\nprint(\\\"   The $35k difference in gross wealth ($255k - $220k) is reduced to $15k\\\")\\nprint(\\\"   because you spent an extra $20k to build that equity:\\\")\\nprint(f\\\"   • Rent paid: ${two_year_result['total_rent']:,.2f}\\\")\\nprint(f\\\"   • Interest + Ownership: ${two_year_result['total_interest'] + two_year_result['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"   • Extra spent on buying: ${(two_year_result['total_interest'] + two_year_result['total_ownership_costs']) - two_year_result['total_rent']:,.2f}\\\")\\nprint(f\\\"\\\\n   Your $35k extra equity - $20k extra costs = $15k better off!\\\")\",\"internalMetadata\":{\"internalId\":\"a8bf3b55\",\"runStartTimeAdjustment\":0,\"executionId\":\"baa5ccce-2db6-4b37-813f-3c8d0713edba\",\"runStartTime\":1762134028387,\"runEndTime\":1762134028403,\"lastRunSuccess\":true,\"executionOrder\":16,\"renderDuration\":{\"vscode.builtin-renderer\":2}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"9eb53a57\",\"metadata\":{}},\"outputs\":[],\"source\":\"### Visual Breakdown: Where Did The $20k Go?\",\"internalMetadata\":{\"internalId\":\"409780f4\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":17,\"id\":\"5e3eb7f1\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"403d342a-9fc7-456f-bb14-0997b8f1876f\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE2MDB4NzAwIHdpdGggMiBBeGVzPg==\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"8485e12d-542c-447a-94e9-52b248329228\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Visualize the cash flows\\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\\n\\n# Scenario A breakdown\\nax1.set_title('SCENARIO A: Rent + Invest', fontsize=14, fontweight='bold')\\ncategories_a = ['Starting\\\\nCapital', 'Investment\\\\nGains', 'Rent\\\\nPaid', 'Final\\\\nPosition']\\nvalues_a = [deposit/1000, two_year_result['investment_gains']/1000, \\n            -two_year_result['total_rent']/1000, two_year_result['scenario_a_net_wealth']/1000]\\ncolors_a = ['blue', 'green', 'red', 'purple']\\n\\nbars_a = ax1.bar(categories_a, values_a, color=colors_a, alpha=0.7, edgecolor='black', linewidth=2)\\nax1.axhline(y=0, color='black', linewidth=0.5)\\nax1.set_ylabel('Amount ($1000s)', fontsize=12)\\nax1.grid(True, alpha=0.3, axis='y')\\n\\nfor i, bar in enumerate(bars_a):\\n    height = bar.get_height()\\n    label_y = height + 5 if height > 0 else height - 10\\n    ax1.text(bar.get_x() + bar.get_width()/2., label_y,\\n            f'${abs(height):.1f}k',\\n            ha='center', va='bottom' if height > 0 else 'top', \\n            fontsize=11, fontweight='bold')\\n\\n# Add flow arrows\\nax1.annotate('', xy=(1, 200), xytext=(0, 200),\\n            arrowprops=dict(arrowstyle='->', lw=2, color='green'))\\nax1.annotate('', xy=(3, 158), xytext=(2, 158),\\n            arrowprops=dict(arrowstyle='->', lw=2, color='red'))\\n\\n# Scenario B breakdown\\nax2.set_title('SCENARIO B: Buy + Sell', fontsize=14, fontweight='bold')\\ncategories_b = ['Equity\\\\nFrom Sale', 'Interest\\\\nPaid', 'Ownership\\\\nCosts', 'Final\\\\nPosition']\\nvalues_b = [two_year_result['equity']/1000, -two_year_result['total_interest']/1000,\\n            -two_year_result['total_ownership_costs']/1000, two_year_result['scenario_b_net_wealth']/1000]\\ncolors_b = ['green', 'red', 'orange', 'purple']\\n\\nbars_b = ax2.bar(categories_b, values_b, color=colors_b, alpha=0.7, edgecolor='black', linewidth=2)\\nax2.axhline(y=0, color='black', linewidth=0.5)\\nax2.set_ylabel('Amount ($1000s)', fontsize=12)\\nax2.grid(True, alpha=0.3, axis='y')\\n\\nfor i, bar in enumerate(bars_b):\\n    height = bar.get_height()\\n    label_y = height + 5 if height > 0 else height - 10\\n    ax2.text(bar.get_x() + bar.get_width()/2., label_y,\\n            f'${abs(height):.1f}k',\\n            ha='center', va='bottom' if height > 0 else 'top', \\n            fontsize=11, fontweight='bold')\\n\\n# Add annotation showing the extra costs\\nax2.annotate('Extra costs\\\\nvs renting:\\\\n$20k', \\n            xy=(1.5, -40), fontsize=11, fontweight='bold', color='red',\\n            ha='center', bbox=dict(boxstyle='round,pad=0.5', facecolor='pink', alpha=0.7))\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nprint(\\\"RECONCILIATION: Why only $15k better, not $35k?\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\nGross wealth difference:  ${two_year_result['equity']/1000:.1f}k - ${two_year_result['invested_deposit_value']/1000:.1f}k = ${(two_year_result['equity'] - two_year_result['invested_deposit_value'])/1000:.1f}k\\\")\\nprint(f\\\"Minus extra costs paid:   ${((two_year_result['total_interest'] + two_year_result['total_ownership_costs']) - two_year_result['total_rent'])/1000:.1f}k\\\")\\nprint(f\\\"                          ─────────\\\")\\nprint(f\\\"Net benefit:              ${two_year_result['wealth_difference']/1000:.1f}k\\\")\\nprint(f\\\"\\\\n✓ Your equity is $35k higher, but you paid $20k more to get there!\\\")\\nprint(f\\\"✓ That $20k extra bought you $35k in equity = $15k profit!\\\")\",\"internalMetadata\":{\"internalId\":\"7fda82e8\",\"runStartTimeAdjustment\":0,\"executionId\":\"8da6178e-fbe2-494e-8988-f8e7428144c3\",\"runStartTime\":1762134049449,\"runEndTime\":1762134049695,\"lastRunSuccess\":true,\"executionOrder\":17,\"renderDuration\":{\"jupyter-notebook-renderer\":3,\"vscode.builtin-renderer\":0}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"5a201d46\",\"metadata\":{}},\"outputs\":[],\"source\":\"## The Compounding Advantage: Repeating the Strategy\\n\\n**Critical insight:** After 2 years, you have MORE capital to reinvest!\\n\\n- **Rent scenario:** You have $220k to make the next decision\\n- **Buy-sell scenario:** You have $256k to make the next decision\\n\\nThis $35k advantage compounds if you repeat the strategy!\",\"internalMetadata\":{\"internalId\":\"4ffa3bde\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":18,\"id\":\"e8cb2700\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"27e09f2a-b8a1-4e84-a32d-e9909c0a1fd7\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Simulate repeating the 2-year buy-sell strategy multiple times\\ndef simulate_repeated_strategy(num_cycles, property_growth_rate=0.03, investment_return_rate=0.05):\\n    \\\"\\\"\\\"\\n    Simulate repeating the 2-year buy-sell strategy multiple times.\\n    Compare to just renting and investing.\\n    \\\"\\\"\\\"\\n    results = []\\n    \\n    # Starting capital\\n    rent_capital = deposit\\n    buy_capital = deposit\\n    \\n    for cycle in range(1, num_cycles + 1):\\n        years = cycle * 2\\n        \\n        # RENT SCENARIO: Just compound the investment\\n        rent_capital_end = rent_capital * (1 + investment_return_rate) ** 2\\n        rent_paid_cycle = monthly_rent * 24\\n        rent_capital_after_rent = rent_capital_end - rent_paid_cycle\\n        \\n        # BUY-SELL SCENARIO: Use current capital as deposit\\n        # Scale the loan proportionally to maintain same LVR (70.4%)\\n        lvr = P / (deposit + P)  # Original LVR\\n        property_price = buy_capital / (1 - lvr)\\n        loan_amount = property_price * lvr\\n        \\n        # Calculate costs for this cycle\\n        interest_cycle = interest_paid(loan_amount, r, c, 24) * (loan_amount / P)  # Scale by loan size\\n        ownership_costs_cycle = 4552.99 + 28001.45 * 1  # Year 1 waived, year 2 full\\n        \\n        # Property appreciation\\n        property_end_value = property_price * (1 + property_growth_rate) ** 2\\n        loan_remaining = principal_remaining(loan_amount, r, c, 24) * (loan_amount / P)\\n        equity_cycle = property_end_value - loan_remaining\\n        \\n        # After paying costs\\n        buy_capital_after_costs = equity_cycle - interest_cycle - ownership_costs_cycle\\n        \\n        results.append({\\n            'cycle': cycle,\\n            'years': years,\\n            'rent_capital': rent_capital_after_rent,\\n            'buy_capital': buy_capital_after_costs,\\n            'difference': buy_capital_after_costs - rent_capital_after_rent,\\n            'rent_starting': rent_capital,\\n            'buy_starting': buy_capital\\n        })\\n        \\n        # Update capital for next cycle\\n        rent_capital = rent_capital_after_rent\\n        buy_capital = buy_capital_after_costs\\n    \\n    return results\\n\\n# Simulate 3 cycles (6 years)\\ncycles_results = simulate_repeated_strategy(3, 0.03, 0.05)\\n\\nprint(\\\"=\\\"*80)\\nprint(\\\"REPEATING THE 2-YEAR BUY-SELL STRATEGY\\\")\\nprint(\\\"=\\\"*80)\\nprint(f\\\"\\\\nCycle | Years | Rent Capital | Buy Capital  | Advantage  | Cumulative Gain\\\")\\nprint(\\\"─\\\" * 80)\\n\\nfor result in cycles_results:\\n    print(f\\\"  {result['cycle']}   |   {result['years']}   | ${result['rent_capital']:>11,.0f} | ${result['buy_capital']:>11,.0f} | ${result['difference']:>9,.0f} | {((result['buy_capital']/result['rent_capital'] - 1)*100):>6.1f}%\\\")\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*80)\\nprint(\\\"THE COMPOUNDING EFFECT\\\")\\nprint(\\\"=\\\"*80)\\nfinal_result = cycles_results[-1]\\nprint(f\\\"\\\\nAfter {final_result['years']} years (3 cycles of 2-year buy-sell):\\\")\\nprint(f\\\"  Rent + Invest: ${final_result['rent_capital']:,.2f}\\\")\\nprint(f\\\"  Buy-Sell-Repeat: ${final_result['buy_capital']:,.2f}\\\")\\nprint(f\\\"  Difference: ${final_result['difference']:,.2f}\\\")\\nprint(f\\\"  That's {((final_result['buy_capital']/final_result['rent_capital'] - 1)*100):.1f}% more wealth!\\\")\\n\\nprint(f\\\"\\\\n💡 Starting with ${deposit:,.0f}:\\\")\\nprint(f\\\"   • Rent strategy: {((final_result['rent_capital']/deposit - 1)*100):.1f}% total return ({((final_result['rent_capital']/deposit)**(1/final_result['years']) - 1)*100:.1f}% p.a.)\\\")\\nprint(f\\\"   • Buy-sell strategy: {((final_result['buy_capital']/deposit - 1)*100):.1f}% total return ({((final_result['buy_capital']/deposit)**(1/final_result['years']) - 1)*100:.1f}% p.a.)\\\")\\n\\nprint(\\\"\\\\n🎯 KEY INSIGHT:\\\")\\nprint(f\\\"   The $15k advantage after cycle 1 becomes ${final_result['difference']:,.0f} after cycle 3\\\")\\nprint(\\\"   because you're reinvesting a LARGER capital base each time!\\\")\",\"internalMetadata\":{\"internalId\":\"565d0ec9\",\"runStartTimeAdjustment\":0,\"executionId\":\"2c70f58d-7496-46d3-aec0-3376b8c430fc\",\"runStartTime\":1762134172355,\"runEndTime\":1762134172359,\"lastRunSuccess\":true,\"executionOrder\":18,\"renderDuration\":{\"vscode.builtin-renderer\":2}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"1557bd9d\",\"metadata\":{}},\"outputs\":[],\"source\":\"### Visualizing the Compounding Effect\",\"internalMetadata\":{\"internalId\":\"c7c0190d\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":19,\"id\":\"6f8d7f1c\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"da26719d-1ae8-49ed-a738-8dc84d085eec\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE2MDB4NjAwIHdpdGggMiBBeGVzPg==\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"4f