omparison(m) for m in timepoints]\\n\\ndf = pd.DataFrame({\\n    'Years': [r['years'] for r in results],\\n    'Wealth Difference ($)': [r['wealth_difference'] for r in results],\\n    'Better Option': [r['better_option'] for r in results],\\n    'Rent Net Wealth ($)': [r['rent_net_wealth'] for r in results],\\n    'Buy Net Wealth ($)': [r['buy_net_wealth'] for r in results]\\n})\\n\\nprint(\\\"=\\\"*80)\\nprint(\\\"EXIT TIMING ANALYSIS\\\")\\nprint(\\\"=\\\"*80)\\nprint(f\\\"\\\\nHold Period | Wealth Diff | Winner | Rent Net | Buy Net\\\")\\nprint(\\\"─\\\" * 80)\\n\\nfor _, row in df.iterrows():\\n    winner_symbol = \\\"✓\\\" if row['Better Option'] == 'Buy' else \\\"✗\\\"\\n    print(f\\\"{row['Years']:>6.0f} years | ${row['Wealth Difference ($)']:>11,.0f} | {winner_symbol} {row['Better Option']:<4} | ${row['Rent Net Wealth ($)']:>9,.0f} | ${row['Buy Net Wealth ($)']:>9,.0f}\\\")\\n\\nprint(\\\"\\\\n💡 Key observations:\\\")\\nprint(f\\\"   • At 2 years: ${df.iloc[1]['Wealth Difference ($)']:,.0f} advantage (tax-free in NZ)\\\")\\nprint(f\\\"   • At 5 years: ${df.iloc[3]['Wealth Difference ($)']:,.0f} advantage\\\")\\nprint(f\\\"   • At 10 years: ${df.iloc[4]['Wealth Difference ($)']:,.0f} advantage\\\")\\nprint(f\\\"   • At 30 years: ${df.iloc[-1]['Wealth Difference ($)']:,.0f} advantage\\\")\",\"internalMetadata\":{\"internalId\":\"960f81e2\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"metadata\":{},\"id\":\"ec892f97\"},\"outputs\":[],\"source\":\"## Summary\\n\\n**To analyze a new property:**\\n1. Update the parameters in the first cell (property price, deposit, rates, body corp, rent)\\n2. Run all cells to see the complete analysis\\n\\n**Key insights:**\\n- Income is calculated assuming 50% of after-tax income goes to housing\\n- The analysis compares rent vs buy with the same income level\\n- Property leverage effect: your deposit controls a much larger appreciating asset\\n- Even with monthly surplus investing (rent scenario), buying typica