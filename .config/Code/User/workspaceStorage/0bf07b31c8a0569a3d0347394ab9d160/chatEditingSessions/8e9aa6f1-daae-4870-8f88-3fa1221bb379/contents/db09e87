k['monthly_rent']], \\n        color='green', alpha=0.7, label='Surplus to Invest')\\n\\nax1.set_ylabel('Amount ($)', fontsize=12)\\nax1.axhline(y=0, color='black', linewidth=0.5)\\nax1.legend(loc='upper right')\\nax1.grid(True, alpha=0.3, axis='y')\\n\\n# Add annotations\\nax1.annotate(f'${surplus_rent:,.0f}\\\\nsurplus', \\n            xy=(1, result_62k['monthly_rent'] + surplus_rent/2), \\n            fontsize=11, fontweight='bold', color='darkgreen', ha='center')\\nmonthly_buy_cost = result_62k['monthly_total_buy']\\nax1.annotate(f'${monthly_buy_cost:,.0f}\\\\n(almost breakeven)', \\n            xy=(2, monthly_buy_cost/2), \\n            fontsize=10, fontweight='bold', color='white', ha='center')\\n\\n# RIGHT: Final wealth comparison\\nax2.set_title('Total Wealth After 2 Years', fontsize=14, fontweight='bold')\\nscenarios = ['Rent\\\\n+Invest\\\\nSurplus', 'Buy']\\nwealth_values = [result_62k['total_wealth_rent']/1000, result_62k['total_wealth_buy']/1000]\\n\\n# Stacked bars showing components\\nax2.bar([0], [result_62k['invested_deposit_value']/1000], \\n        color='blue', alpha=0.7, label='Deposit Growth')\\nax2.bar([0], [result_62k['surplus_invested']/1000], \\n        bottom=[result_62k['invested_deposit_value']/1000],\\n        color='green', alpha=0.7, label='Surplus Invested')\\nax2.bar([1], [result_62k['equity']/1000], \\n        color='purple', alpha=0.7, label='Property Equity')\\n\\nax2.set_ylabel('Wealth ($1000s)', fontsize=12)\\nax2.set_xticks([0, 1])\\nax2.set_xticklabels(scenarios)\\nax2.legend(loc='upper left')\\nax2.grid(True, alpha=0.3, axis='y')\\n\\n# Add total labels\\nfor i, val in enumerate(wealth_values):\\n    ax2.text(i, val + 5, f'${val:.1f}k\\\\nTotal', \\n            ha='center', va='bottom', fontsize=11, fontweight='bold')\\n\\n# Show difference\\ndiff = result_62k['wealth_difference']\\nax2.annotate(f'${diff/1000:.1f}k\\\\nadvantage', \\n            xy=(0.5, max(wealth_values) - 10), \\n            fontsize=12, fontweight='bold'