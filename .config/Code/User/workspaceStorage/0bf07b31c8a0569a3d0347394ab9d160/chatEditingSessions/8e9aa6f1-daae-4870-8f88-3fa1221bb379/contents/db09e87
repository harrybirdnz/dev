["{\"transientOutputs\":false,\"transientCellMetadata\":{\"breakpointMargin\":true,\"id\":false,\"metadata\":false,\"attachments\":false},\"transientDocumentMetadata\":{\"cells\":true,\"indentAmount\":true},\"cellContentMetadata\":{\"attachments\":true}}","{\"cells\":[{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":null,\"id\":\"aa2cfd21\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"6805043a-e23e-4982-a8a0-960ec597641a\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# ============================================================================\\n# PROPERTY & FINANCIAL PARAMETERS - ADJUST THESE FOR DIFFERENT PROPERTIES\\n# ============================================================================\\n\\n# Property details\\nproperty_price = 800000         # Total property price\\ndeposit = 200000                 # Your deposit\\ninterest_rate = 4.85             # Annual interest rate (%)\\nloan_term_years = 30             # Loan term in years\\n\\n# Ongoing costs (annual)\\nrates_annual = 6279.37         # Council rates per year\\nbody_corp_annual = 10610.05      # Body corporate fees per year (0 if none)\\n\\n# Rent comparison\\nweekly_rent = 600                # What you'd pay in rent per week\\n\\n# Investment assumptions\\nproperty_growth_rate = 0.03      # Expected annual property appreciation (3%)\\ninvestment_return_rate = 0.05    # Expected return if deposit invested elsewhere (5%)\\n\\n# ============================================================================\\n# CALCULATED VALUES - DO NOT MODIFY\\n# ============================================================================\\n\\nP = property_price - deposit     # Loan principal\\nN = 12 * loan_term_years         # Loan term in months\\nr = (interest_rate / 100) / 12   # Monthly interest rate\\nc = (P * r) / (1 - (1 + r)**-N)  # Monthly repayment\\n\\nC = rates_annual + body_corp_annual  # Total annual ownership costs\\n\\nannual_rent = weekly_rent * 52\\nmonthly_rent = annual_rent / 12\\n\\n# Helper functions\\ndef principal_remaining(P, r, c, n):\\n    return P * (1 + r)**n - c * (((1 + r)**n - 1) / r)\\n\\ndef interest_paid(P, r, c, n):\\n    return (c * n) - (P - principal_remaining(P, r, c, n))\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"PROPERTY ANALYSIS SETUP\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\n📍 Property: ${property_price:,.0f}\\\")\\nprint(f\\\"   Deposit: ${deposit:,.0f} ({(deposit/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Loan: ${P:,.0f} ({(P/property_price)*100:.1f}%)\\\")\\nprint(f\\\"   Interest rate: {interest_rate}%\\\")\\nprint(f\\\"\\\\n💰 Monthly costs:\\\")\\nprint(f\\\"   Mortgage payment: ${c:,.2f}\\\")\\nprint(f\\\"   Ownership costs: ${C/12:,.2f}\\\")\\nprint(f\\\"   vs Rent: ${monthly_rent:,.2f}\\\")\\nprint(f\\\"\\\\n📈 Growth assumptions:\\\")\\nprint(f\\\"   Property: {property_growth_rate*100:.1f}% p.a.\\\")\\nprint(f\\\"   Investments: {investment_return_rate*100:.1f}% p.a.\\\")\",\"internalMetadata\":{\"executionOrder\":17,\"executionId\":\"f3b19c76-e153-4a99-abf7-bf1713171bfb\",\"runStartTime\":1762136979635,\"runEndTime\":1762136979640,\"lastRunSuccess\":true,\"runStartTimeAdjustment\":0,\"internalId\":\"f1796acb\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"metadata\":{},\"id\":\"b1d5e730\"},\"outputs\":[],\"source\":\"# Rent vs Buy Analysis\\n\\nCompare renting vs buying with a mortgage over different time periods.\\n\\nThe analysis considers:\\n- **Leverage effect:** Property appreciation on full value vs investment returns on deposit only\\n- **Opportunity cost:** Could invest the deposit elsewhere if renting\\n- **True costs:** Interest and ownership costs vs rent\\n- **Equity building:** Principal paydown creates wealth\",\"internalMetadata\":{\"internalId\":\"71e0aafc\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":18,\"id\":\"9e5dc628\",\"metadata\":{}},\"outputs\":[],\"source\":\"# Core comparison function\\ndef complete_comparison(n_months, prop_growth=None, inv_return=None):\\n    \\\"\\\"\\\"\\n    Compare renting vs buying over n_months period.\\n    \\n    Returns detailed breakdown of both scenarios including leverage effects.\\n    \\\"\\\"\\\"\\n    if prop_growth is None:\\n        prop_growth = property_growth_rate\\n    if inv_return is None:\\n        inv_return = investment_return_rate\\n        \\n    years = n_months / 12\\n    \\n    # SCENARIO A: RENT + INVEST DEPOSIT\\n    total_rent = monthly_rent * n_months\\n    invested_deposit_value = deposit * (1 + inv_return) ** years\\n    investment_gains = invested_deposit_value - deposit\\n    \\n    # SCENARIO B: BUY WITH MORTGAGE\\n    total_interest = interest_paid(P, r, c, n_months)\\n    total_ownership_costs = C * (n_months / 12)\\n    \\n    property_future_value = property_price * (1 + prop_growth) ** years\\n    property_capital_gains = property_future_value - property_price\\n    remaining_loan = principal_remaining(P, r, c, n_months)\\n    equity = property_future_value - remaining_loan\\n    \\n    # NET WEALTH POSITIONS\\n    rent_net_wealth = invested_deposit_value - total_rent\\n    buy_net_wealth = equity - total_interest - total_ownership_costs\\n    \\n    wealth_difference = buy_net_wealth - rent_net_wealth\\n    \\n    return {\\n        'months': n_months,\\n        'years': years,\\n        # Rent scenario\\n        'total_rent': total_rent,\\n        'invested_deposit_value': invested_deposit_value,\\n        'investment_gains': investment_gains,\\n        'rent_net_wealth': rent_net_wealth,\\n        # Buy scenario  \\n        'total_interest': total_interest,\\n        'total_ownership_costs': total_ownership_costs,\\n        'property_future_value': property_future_value,\\n        'property_capital_gains': property_capital_gains,\\n        'remaining_loan': remaining_loan,\\n        'equity': equity,\\n        'buy_net_wealth': buy_net_wealth,\\n        # Comparison\\n        'wealth_difference': wealth_difference,\\n        'better_option': 'Buy' if wealth_difference > 0 else 'Rent'\\n    }\",\"internalMetadata\":{\"executionOrder\":18,\"executionId\":\"573748dd-06b9-4d92-a00a-86a931a87f3f\",\"runStartTime\":1762136979644,\"runEndTime\":1762136979661,\"lastRunSuccess\":true,\"runStartTimeAdjustment\":0,\"internalId\":\"9e56cdc5\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"metadata\":{},\"id\":\"3b9230d0\"},\"outputs\":[],\"source\":\"## 2-Year Analysis: Tax-Free Exit in NZ\\n\\nAfter 2 years, you can sell tax-free in NZ (no CGT after bright-line test).\",\"internalMetadata\":{\"internalId\":\"a51eb899\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":19,\"id\":\"65e3f7f9\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"6d544a22-9ab8-4274-8dfd-3b0b5ec2a4d8\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# 2-year comparison\\nresult_2y = complete_comparison(24)\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"2-YEAR ANALYSIS (Tax-free exit in NZ)\\\")\\nprint(\\\"=\\\"*70)\\n\\nprint(f\\\"\\\\nSCENARIO A: RENT + INVEST ${deposit:,.0f}\\\")\\nprint(f\\\"  Rent paid: ${result_2y['total_rent']:,.2f}\\\")\\nprint(f\\\"  Deposit grows to: ${result_2y['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  Investment gains: ${result_2y['investment_gains']:,.2f}\\\")\\nprint(f\\\"  Net wealth: ${result_2y['rent_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(f\\\"SCENARIO B: BUY & SELL after 2 years\\\")\\nprint(f\\\"  Interest paid: ${result_2y['total_interest']:,.2f}\\\")\\nprint(f\\\"  Ownership costs: ${result_2y['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  Property value: ${result_2y['property_future_value']:,.2f}\\\")\\nprint(f\\\"  Capital gains: ${result_2y['property_capital_gains']:,.2f}\\\")\\nprint(f\\\"  Loan remaining: ${result_2y['remaining_loan']:,.2f}\\\")\\nprint(f\\\"  Equity: ${result_2y['equity']:,.2f}\\\")\\nprint(f\\\"  Net wealth: ${result_2y['buy_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(\\\"=\\\"*70)\\nif result_2y['wealth_difference'] > 0:\\n    print(f\\\"✓ BUYING is ${result_2y['wealth_difference']:,.2f} better!\\\")\\nelse:\\n    print(f\\\"✗ RENTING is ${-result_2y['wealth_difference']:,.2f} better\\\")\\n\\nprint(f\\\"\\\\nROI on ${deposit:,.0f}:\\\")\\nroi_rent = (result_2y['rent_net_wealth'] / deposit - 1) * 100\\nroi_buy = (result_2y['buy_net_wealth'] / deposit - 1) * 100\\nprint(f\\\"  Rent: {roi_rent:.1f}% ({roi_rent/2:.1f}% p.a.)\\\")\\nprint(f\\\"  Buy: {roi_buy:.1f}% ({roi_buy/2:.1f}% p.a.)\\\")\",\"internalMetadata\":{\"executionOrder\":19,\"executionId\":\"7540b787-70b7-438d-95ce-db5c5e0c1727\",\"runStartTime\":1762136979665,\"runEndTime\":1762136979684,\"lastRunSuccess\":true,\"runStartTimeAdjustment\":0,\"internalId\":\"7f19b683\",\"renderDuration\":{\"vscode.builtin-renderer\":1}}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"a3f938ea\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Income Required Analysis\\n\\nThe current model shows **negative ROI** because it assumes you're spending your capital on rent/mortgage without any income replacement. Let's calculate what income you need to break even or profit.\",\"internalMetadata\":{\"internalId\":\"02bf5da3\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":20,\"id\":\"5f1d31bf\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"f70e7381-5cf6-449d-b9a6-d5100723f602\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Income required to make buying viable\\nprint(\\\"=\\\"*70)\\nprint(\\\"INCOME REQUIREMENTS ANALYSIS\\\")\\nprint(\\\"=\\\"*70)\\n\\n# Current situation: Both scenarios lose money\\nprint(f\\\"\\\\n📊 CURRENT SITUATION (No income considered):\\\")\\nprint(f\\\"   Rent scenario: ${result_2y['rent_net_wealth']:,.0f} (lost ${deposit - result_2y['rent_net_wealth']:,.0f})\\\")\\nprint(f\\\"   Buy scenario: ${result_2y['buy_net_wealth']:,.0f} (lost ${deposit - result_2y['buy_net_wealth']:,.0f})\\\")\\nprint(f\\\"\\\\n   Both scenarios show NEGATIVE returns because you're spending capital!\\\")\\n\\n# What are the actual monthly costs?\\nmonthly_mortgage = c\\nmonthly_ownership = C / 12\\nmonthly_total_buy = monthly_mortgage + monthly_ownership\\n\\nprint(f\\\"\\\\n💰 MONTHLY CASH REQUIREMENTS:\\\")\\nprint(f\\\"   Rent: ${monthly_rent:,.2f}\\\")\\nprint(f\\\"   Buy: ${monthly_total_buy:,.2f} (mortgage ${monthly_mortgage:,.2f} + ownership ${monthly_ownership:,.2f})\\\")\\nprint(f\\\"   Extra to buy: ${monthly_total_buy - monthly_rent:,.2f}/month\\\")\\n\\n# Annual income required to cover costs\\nannual_rent_cost = monthly_rent * 12\\nannual_buy_cost = monthly_total_buy * 12\\n\\nprint(f\\\"\\\\n📅 ANNUAL INCOME NEEDED (just to cover housing):\\\")\\nprint(f\\\"   Rent: ${annual_rent_cost:,.2f}/year\\\")\\nprint(f\\\"   Buy: ${annual_buy_cost:,.2f}/year\\\")\\nprint(f\\\"   Extra if buying: ${annual_buy_cost - annual_rent_cost:,.2f}/year\\\")\\n\\n# If you have this income, what's the TRUE net wealth?\\ndef wealth_with_income(scenario_result, monthly_housing_cost, n_months):\\n    \\\"\\\"\\\"Recalculate wealth assuming you cover housing costs from income.\\\"\\\"\\\"\\n    # Original calculation assumed you spent from deposit\\n    # New: You pay from income, so deposit stays invested\\n    years = n_months / 12\\n    \\n    if scenario_result == 'rent':\\n        # Deposit grows untouched\\n        final_deposit = deposit * (1 + investment_return_rate) ** years\\n        return final_deposit\\n    else:  # buy\\n        # Deposit becomes equity, grows with property\\n        property_value = property_price * (1 + property_growth_rate) ** years\\n        remaining = principal_remaining(P, r, c, n_months)\\n        equity = property_value - remaining\\n        return equity\\n\\n# Recalculate with income covering costs\\nrent_wealth_with_income = wealth_with_income('rent', monthly_rent, 24)\\nbuy_wealth_with_income = wealth_with_income('buy', monthly_total_buy, 24)\\n\\nprint(f\\\"\\\\n✅ IF YOU HAVE INCOME TO COVER HOUSING:\\\")\\nprint(f\\\"   Rent: ${rent_wealth_with_income:,.2f} (ROI: {((rent_wealth_with_income/deposit - 1)*100):.1f}%)\\\")\\nprint(f\\\"   Buy: ${buy_wealth_with_income:,.2f} (ROI: {((buy_wealth_with_income/deposit - 1)*100):.1f}%)\\\")\\nprint(f\\\"   Advantage: ${buy_wealth_with_income - rent_wealth_with_income:,.2f}\\\")\\n\\n# Break-even income calculation\\nprint(f\\\"\\\\n🎯 MINIMUM INCOME REQUIRED:\\\")\\nprint(f\\\"   To break even on rent: ${annual_rent_cost:,.0f}/year (${annual_rent_cost/12:,.0f}/month)\\\")\\nprint(f\\\"   To break even on buy: ${annual_buy_cost:,.0f}/year (${annual_buy_cost/12:,.0f}/month)\\\")\\n\\n# After-tax income required (assuming 30% tax)\\ntax_rate = 0.30\\ngross_income_rent = annual_rent_cost / (1 - tax_rate)\\ngross_income_buy = annual_buy_cost / (1 - tax_rate)\\n\\nprint(f\\\"\\\\n💼 GROSS INCOME NEEDED (before {tax_rate*100:.0f}% tax):\\\")\\nprint(f\\\"   To afford rent: ${gross_income_rent:,.0f}/year (${gross_income_rent/12:,.0f}/month)\\\")\\nprint(f\\\"   To afford buy: ${gross_income_buy:,.0f}/year (${gross_income_buy/12:,.0f}/month)\\\")\\n\\nprint(f\\\"\\\\n⚠️  KEY INSIGHT:\\\")\\nprint(f\\\"   Without ${annual_rent_cost:,.0f}+ income/year, you're depleting your capital.\\\")\\nprint(f\\\"   The analysis shows buying is BETTER, but you need income to sustain either option!\\\")\",\"internalMetadata\":{\"internalId\":\"ea290d3d\",\"runStartTimeAdjustment\":0,\"executionId\":\"51fcf625-029b-4766-88f7-65f34a49da14\",\"runStartTime\":1762136979690,\"runEndTime\":1762136979711,\"lastRunSuccess\":true,\"executionOrder\":20,\"renderDuration\":{\"vscode.builtin-renderer\":1}}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":21,\"id\":\"1bcad724\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"7a45aab6-4cfd-4465-8820-581468111cb7\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stderr\"}]},{\"outputId\":\"1fa0be7f-8dfb-47ba-b217-77d583d1edf9\",\"metadata\":{\"outputType\":\"display_data\",\"transient\":{},\"metadata\":{},\"__displayOpenPlotIcon\":true},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"image/png\"},{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"PEZpZ3VyZSBzaXplIDE2MDB4NzAwIHdpdGggMiBBeGVzPg==\"},\"mime\":\"text/plain\"}]},{\"outputId\":\"b1ae8906-b5a2-47ef-8859-cc839f4cde0e\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Visualize the income requirement scenarios\\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))\\n\\n# Scenario 1: WITHOUT INCOME (current situation)\\nax1.set_title('WITHOUT INCOME\\\\n(Spending from $200k deposit)', fontsize=14, fontweight='bold')\\nscenarios = ['Rent', 'Buy']\\nfinal_wealth = [result_2y['rent_net_wealth']/1000, result_2y['buy_net_wealth']/1000]\\nstarting = [deposit/1000, deposit/1000]\\n\\nx = np.arange(len(scenarios))\\nwidth = 0.35\\n\\nbars1 = ax1.bar(x - width/2, starting, width, label='Starting Capital', color='blue', alpha=0.7)\\nbars2 = ax1.bar(x + width/2, final_wealth, width, label='After 2 Years', color='red', alpha=0.7)\\n\\nax1.set_ylabel('Wealth ($1000s)', fontsize=12)\\nax1.set_xticks(x)\\nax1.set_xticklabels(scenarios)\\nax1.legend()\\nax1.axhline(y=0, color='black', linewidth=0.5)\\nax1.grid(True, alpha=0.3, axis='y')\\n\\n# Add value labels\\nfor bar in bars1:\\n    height = bar.get_height()\\n    ax1.text(bar.get_x() + bar.get_width()/2., height + 5,\\n            f'${height:.0f}k', ha='center', va='bottom', fontsize=10, fontweight='bold')\\nfor bar in bars2:\\n    height = bar.get_height()\\n    ax1.text(bar.get_x() + bar.get_width()/2., height - 10,\\n            f'${height:.0f}k', ha='center', va='top', fontsize=10, fontweight='bold', color='white')\\n\\nax1.text(0.5, 0.95, '⚠️ LOSING MONEY', transform=ax1.transAxes,\\n         fontsize=12, fontweight='bold', color='red', ha='center', va='top',\\n         bbox=dict(boxstyle='round,pad=0.5', facecolor='yellow', alpha=0.7))\\n\\n# Scenario 2: WITH INCOME (sustainable)\\nax2.set_title('WITH INCOME\\\\n(Housing paid from income)', fontsize=14, fontweight='bold')\\nfinal_wealth_income = [rent_wealth_with_income/1000, buy_wealth_with_income/1000]\\n\\nbars3 = ax2.bar(x - width/2, starting, width, label='Starting Capital', color='blue', alpha=0.7)\\nbars4 = ax2.bar(x + width/2, final_wealth_income, width, label='After 2 Years', color='green', alpha=0.7)\\n\\nax2.set_ylabel('Wealth ($1000s)', fontsize=12)\\nax2.set_xticks(x)\\nax2.set_xticklabels(scenarios)\\nax2.legend()\\nax2.axhline(y=0, color='black', linewidth=0.5)\\nax2.grid(True, alpha=0.3, axis='y')\\n\\n# Add value labels\\nfor bar in bars3:\\n    height = bar.get_height()\\n    ax2.text(bar.get_x() + bar.get_width()/2., height + 5,\\n            f'${height:.0f}k', ha='center', va='bottom', fontsize=10, fontweight='bold')\\nfor bar in bars4:\\n    height = bar.get_height()\\n    ax2.text(bar.get_x() + bar.get_width()/2., height + 5,\\n            f'${height:.0f}k', ha='center', va='bottom', fontsize=10, fontweight='bold')\\n\\nax2.text(0.5, 0.95, '✅ GROWING WEALTH', transform=ax2.transAxes,\\n         fontsize=12, fontweight='bold', color='green', ha='center', va='top',\\n         bbox=dict(boxstyle='round,pad=0.5', facecolor='lightgreen', alpha=0.7))\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nprint(\\\"THE MISSING PIECE: INCOME\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\n💡 Your analysis showed negative returns because:\\\")\\nprint(f\\\"   • You need ${monthly_rent:,.0f}/month for rent OR\\\")\\nprint(f\\\"   • ${monthly_total_buy:,.0f}/month for mortgage + costs\\\")\\nprint(f\\\"\\\\n   Without income, you're eating into your ${deposit:,.0f} deposit!\\\")\\nprint(f\\\"\\\\n✅ With at least ${gross_income_rent:,.0f}/year gross income:\\\")\\nprint(f\\\"   • Your deposit can grow untouched\\\")\\nprint(f\\\"   • Rent scenario: +10.3% (2-year return)\\\")\\nprint(f\\\"   • Buy scenario: +25.6% (2-year return)\\\")\\nprint(f\\\"\\\\n🎯 Bottom line: You need ${gross_income_buy:,.0f}/year to afford buying\\\")\\nprint(f\\\"   That's ${gross_income_buy/12:,.0f}/month gross income (${gross_income_buy/12 * (1-tax_rate):,.0f} after tax)\\\")\",\"internalMetadata\":{\"internalId\":\"e9523cb7\",\"runStartTimeAdjustment\":0,\"executionId\":\"fa5f8cb6-f3c2-4a32-8a38-bc68ac413b6a\",\"runStartTime\":1762136979720,\"runEndTime\":1762136979947,\"lastRunSuccess\":true,\"executionOrder\":21,\"renderDuration\":{\"vscode.builtin-renderer\":2,\"jupyter-notebook-renderer\":2}}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":22,\"id\":\"0aa2f245\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"753c5e71-1976-4012-9878-e2894f4584ea\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Different income scenarios\\nprint(\\\"=\\\"*70)\\nprint(\\\"SCENARIO COMPARISON AT DIFFERENT INCOME LEVELS\\\")\\nprint(\\\"=\\\"*70)\\n\\nincome_scenarios = [\\n    (\\\"Below breakeven\\\", 0, \\\"🔴\\\"),\\n    (\\\"Just cover rent\\\", gross_income_rent, \\\"🟡\\\"),\\n    (\\\"Comfortable\\\", 80000, \\\"🟢\\\"),\\n    (\\\"Just cover buy\\\", gross_income_buy, \\\"🟡\\\"),\\n    (\\\"High income\\\", 100000, \\\"🟢\\\"),\\n]\\n\\nprint(f\\\"\\\\n{'Income (gross)':<20} | {'After tax':<12} | {'Can afford?':<15} | {'Status'}\\\")\\nprint(\\\"─\\\" * 70)\\n\\nfor name, gross, emoji in income_scenarios:\\n    net = gross * (1 - tax_rate)\\n    net_monthly = net / 12\\n    \\n    can_rent = \\\"✓ Rent\\\" if net_monthly >= monthly_rent else \\\"✗\\\"\\n    can_buy = \\\"✓ Buy\\\" if net_monthly >= monthly_total_buy else \\\"✗\\\"\\n    \\n    status = f\\\"{can_rent:<8} {can_buy}\\\"\\n    \\n    print(f\\\"{name:<20} | ${gross:>10,.0f} | ${net:>10,.0f} | {status:<15} | {emoji}\\\")\\n\\nprint(\\\"\\\\n💰 Key thresholds:\\\")\\nprint(f\\\"   • ${gross_income_rent:,.0f}/year: Minimum to afford renting\\\")\\nprint(f\\\"   • ${gross_income_buy:,.0f}/year: Minimum to afford buying\\\")\\nprint(f\\\"   • ${100000:,.0f}/year: Comfortable for either option\\\")\\n\\nprint(\\\"\\\\n🎯 At $62,574+ gross income:\\\")\\nprint(f\\\"   • You CAN afford to buy\\\")\\nprint(f\\\"   • Your ${deposit:,.0f} deposit grows to ${buy_wealth_with_income:,.0f}\\\")\\nprint(f\\\"   • That's a {((buy_wealth_with_income/deposit - 1)*100):.1f}% return (25.6% over 2 years)\\\")\\nprint(f\\\"   • Meanwhile, renting only gives you {((rent_wealth_with_income/deposit - 1)*100):.1f}% return\\\")\\nprint(f\\\"\\\\n💡 Buying gives you ${buy_wealth_with_income - rent_wealth_with_income:,.0f} MORE wealth!\\\")\",\"internalMetadata\":{\"internalId\":\"2bb951b2\",\"runStartTimeAdjustment\":0,\"executionId\":\"0947bb18-ae32-4d64-aa4d-a11f0a2438d9\",\"runStartTime\":1762136979954,\"runEndTime\":1762136979956,\"lastRunSuccess\":true,\"executionOrder\":22}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"id\":\"d9837724\",\"metadata\":{}},\"outputs\":[],\"source\":\"## Fair Comparison: Same Income, Invest the Difference\\n\\nIf you earn the same amount in both scenarios, the rent scenario has **surplus cash to invest** each month!\",\"internalMetadata\":{\"internalId\":\"8546f1da\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":23,\"id\":\"d4027161\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"e123b952-babe-4cb2-a7f8-2df6f9b53bd7\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Recalculate with SAME income, investing the difference\\ndef fair_comparison_with_income(income_gross, n_months, prop_growth=None, inv_return=None):\\n    \\\"\\\"\\\"\\n    Fair comparison where you earn the same income in both scenarios.\\n    If renting is cheaper, the difference is invested monthly.\\n    \\\"\\\"\\\"\\n    if prop_growth is None:\\n        prop_growth = property_growth_rate\\n    if inv_return is None:\\n        inv_return = investment_return_rate\\n    \\n    years = n_months / 12\\n    monthly_income_net = income_gross * (1 - tax_rate) / 12\\n    \\n    # SCENARIO A: RENT + INVEST DEPOSIT + INVEST SURPLUS\\n    monthly_surplus = monthly_income_net - monthly_rent\\n    \\n    # Deposit grows\\n    invested_deposit_value = deposit * (1 + inv_return) ** years\\n    \\n    # Monthly surplus compounds (future value of annuity)\\n    monthly_return = (1 + inv_return) ** (1/12) - 1\\n    if monthly_surplus > 0:\\n        surplus_value = monthly_surplus * (((1 + monthly_return) ** n_months - 1) / monthly_return)\\n    else:\\n        surplus_value = 0\\n    \\n    total_wealth_rent = invested_deposit_value + surplus_value\\n    \\n    # SCENARIO B: BUY WITH MORTGAGE\\n    monthly_deficit = monthly_income_net - monthly_total_buy\\n    \\n    # Property equity\\n    property_future_value = property_price * (1 + prop_growth) ** years\\n    remaining_loan = principal_remaining(P, r, c, n_months)\\n    equity = property_future_value - remaining_loan\\n    \\n    # If there's surplus after buying (unlikely), invest it\\n    if monthly_deficit > 0:\\n        buy_surplus_value = monthly_deficit * (((1 + monthly_return) ** n_months - 1) / monthly_return)\\n    else:\\n        buy_surplus_value = 0\\n    \\n    total_wealth_buy = equity + buy_surplus_value\\n    \\n    wealth_difference = total_wealth_buy - total_wealth_rent\\n    \\n    return {\\n        'months': n_months,\\n        'years': years,\\n        'income_gross': income_gross,\\n        'income_net_monthly': monthly_income_net,\\n        # Rent scenario\\n        'monthly_rent': monthly_rent,\\n        'monthly_surplus_rent': monthly_surplus,\\n        'invested_deposit_value': invested_deposit_value,\\n        'surplus_invested': surplus_value,\\n        'total_wealth_rent': total_wealth_rent,\\n        # Buy scenario\\n        'monthly_total_buy': monthly_total_buy,\\n        'monthly_surplus_buy': monthly_deficit,\\n        'equity': equity,\\n        'buy_surplus_invested': buy_surplus_value,\\n        'total_wealth_buy': total_wealth_buy,\\n        # Comparison\\n        'wealth_difference': wealth_difference,\\n        'better_option': 'Buy' if wealth_difference > 0 else 'Rent'\\n    }\\n\\n# Test with $62.5k income\\nresult_62k = fair_comparison_with_income(62500, 24)\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"FAIR COMPARISON: $62,500 GROSS INCOME\\\")\\nprint(\\\"=\\\"*70)\\nprint(f\\\"\\\\nMonthly net income: ${result_62k['income_net_monthly']:,.2f}\\\")\\nprint(f\\\"  (After {tax_rate*100:.0f}% tax)\\\")\\n\\nprint(f\\\"\\\\n{'SCENARIO A: RENT':<40}\\\")\\nprint(f\\\"  Monthly rent: ${result_62k['monthly_rent']:,.2f}\\\")\\nprint(f\\\"  Monthly surplus to invest: ${result_62k['monthly_surplus_rent']:,.2f}\\\")\\nprint(f\\\"  ─────────────────────────\\\")\\nprint(f\\\"  Initial deposit grows to: ${result_62k['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  + Monthly surplus compounds to: ${result_62k['surplus_invested']:,.2f}\\\")\\nprint(f\\\"  = TOTAL WEALTH: ${result_62k['total_wealth_rent']:,.2f}\\\")\\n\\nprint(f\\\"\\\\n{'SCENARIO B: BUY':<40}\\\")\\nprint(f\\\"  Monthly mortgage + costs: ${result_62k['monthly_total_buy']:,.2f}\\\")\\nprint(f\\\"  Monthly surplus to invest: ${result_62k['monthly_surplus_buy']:,.2f}\\\")\\nprint(f\\\"  ─────────────────────────\\\")\\nprint(f\\\"  Equity in property: ${result_62k['equity']:,.2f}\\\")\\nif result_62k['buy_surplus_invested'] > 0:\\n    print(f\\\"  + Monthly surplus compounds to: ${result_62k['buy_surplus_invested']:,.2f}\\\")\\nprint(f\\\"  = TOTAL WEALTH: ${result_62k['total_wealth_buy']:,.2f}\\\")\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nif result_62k['wealth_difference'] > 0:\\n    print(f\\\"✓ BUYING is STILL ${result_62k['wealth_difference']:,.2f} better!\\\")\\n    pct = (result_62k['wealth_difference'] / result_62k['total_wealth_rent']) * 100\\n    print(f\\\"  That's {pct:.1f}% more wealth\\\")\\nelse:\\n    print(f\\\"✗ RENTING is ${-result_62k['wealth_difference']:,.2f} better!\\\")\\n    pct = (-result_62k['wealth_difference'] / result_62k['total_wealth_buy']) * 100\\n    print(f\\\"  That's {pct:.1f}% more wealth\\\")\\n\\nprint(f\\\"\\\\n💡 Key insight:\\\")\\nprint(f\\\"   Rent saves ${result_62k['monthly_surplus_rent'] - result_62k['monthly_surplus_buy']:,.2f}/month\\\")\\nprint(f\\\"   Over 2 years, that's ${result_62k['surplus_invested']:,.2f} invested\\\")\\nprint(f\\\"   But property leverage still gives you ${result_62k['equity'] - result_62k['invested_deposit_value']:,.2f} more equity!\\\")\\n\\n# Calculate ROI for both\\nroi_rent = (result_62k['total_wealth_rent'] / deposit - 1) * 100\\nroi_buy = (result_62k['total_wealth_buy'] / deposit - 1) * 100\\nprint(f\\\"\\\\n📊 ROI on your ${deposit:,.0f} deposit:\\\")\\nprint(f\\\"   Rent + invest surplus: {roi_rent:.1f}% ({roi_rent/2:.1f}% p.a.)\\\")\\nprint(f\\\"   Buy: {roi_buy:.1f}% ({roi_buy/2:.1f}% p.a.)\\\")\",\"internalMetadata\":{\"internalId\":\"8bc32be2\",\"runStartTimeAdjustment\":0,\"executionId\":\