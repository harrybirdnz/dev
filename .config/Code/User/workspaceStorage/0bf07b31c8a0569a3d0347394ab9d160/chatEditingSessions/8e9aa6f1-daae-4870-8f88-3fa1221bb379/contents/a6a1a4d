ining_loan,\\n        'equity': equity,\\n        'buy_net_wealth': buy_net_wealth,\\n        # Comparison\\n        'wealth_difference': wealth_difference,\\n        'better_option': 'Buy' if wealth_difference > 0 else 'Rent'\\n    }\",\"internalMetadata\":{\"executionOrder\":3,\"executionId\":\"9d62fd13-dc9f-4ba0-90f9-f41bf9a90251\",\"runStartTime\":1762136292003,\"runEndTime\":1762136292030,\"lastRunSuccess\":true,\"runStartTimeAdjustment\":0,\"internalId\":\"9e56cdc5\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"metadata\":{},\"id\":\"3b9230d0\"},\"outputs\":[],\"source\":\"## 2-Year Analysis: Tax-Free Exit in NZ\\n\\nAfter 2 years, you can sell tax-free in NZ (no CGT after bright-line test).\",\"internalMetadata\":{\"internalId\":\"a51eb899\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":4,\"id\":\"65e3f7f9\",\"metadata\":{}},\"outputs\":[{\"outputId\":\"9d4e553f-6bc9-41e5-8435-a6e435c73530\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# 2-year comparison\\nresult_2y = complete_comparison(24)\\n\\nprint(\\\"=\\\"*70)\\nprint(\\\"2-YEAR ANALYSIS (Tax-free exit in NZ)\\\")\\nprint(\\\"=\\\"*70)\\n\\nprint(f\\\"\\\\nSCENARIO A: RENT + INVEST ${deposit:,.0f}\\\")\\nprint(f\\\"  Rent paid: ${result_2y['total_rent']:,.2f}\\\")\\nprint(f\\\"  Deposit grows to: ${result_2y['invested_deposit_value']:,.2f}\\\")\\nprint(f\\\"  Investment gains: ${result_2y['investment_gains']:,.2f}\\\")\\nprint(f\\\"  Net wealth: ${result_2y['rent_net_wealth']:,.2f}\\\\n\\\")\\n\\nprint(f\\\"SCENARIO B: BUY & SELL after 2 years\\\")\\nprint(f\\\"  Interest paid: ${result_2y['total_interest']:,.2f}\\\")\\nprint(f\\\"  Ownership costs: ${result_2y['total_ownership_costs']:,.2f}\\\")\\nprint(f\\\"  Property value: ${result_2y['property_future_value']:,.2f}\\\")\\nprint(f\\\"  Capital 