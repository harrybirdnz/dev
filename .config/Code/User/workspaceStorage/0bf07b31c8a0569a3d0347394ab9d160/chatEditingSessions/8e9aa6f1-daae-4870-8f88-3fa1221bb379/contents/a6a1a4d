inal\\\\nPosition']\\nvalues_b = [result_2y['equity']/1000, -result_2y['total_interest']/1000,\\n            -result_2y['total_ownership_costs']/1000, result_2y['buy_net_wealth']/1000]\\ncolors_b = ['green', 'red', 'orange', 'purple']\\n\\nbars_b = ax2.bar(categories_b, values_b, color=colors_b, alpha=0.7, edgecolor='black', linewidth=2)\\nax2.axhline(y=0, color='black', linewidth=0.5)\\nax2.set_ylabel('Amount ($1000s)', fontsize=12)\\nax2.grid(True, alpha=0.3, axis='y')\\n\\nfor i, bar in enumerate(bars_b):\\n    height = bar.get_height()\\n    label_y = height + 5 if height > 0 else height - 10\\n    ax2.text(bar.get_x() + bar.get_width()/2., label_y,\\n            f'${abs(height):.1f}k',\\n            ha='center', va='bottom' if height > 0 else 'top', \\n            fontsize=11, fontweight='bold')\\n\\n# Add annotation showing the extra costs\\nextra_costs = (result_2y['total_interest'] + result_2y['total_ownership_costs'] - result_2y['total_rent']) / 1000\\nax2.annotate(f'Extra costs\\\\nvs renting:\\\\n${extra_costs:.1f}k', \\n            xy=(1.5, -40), fontsize=11, fontweight='bold', color='red',\\n            ha='center', bbox=dict(boxstyle='round,pad=0.5', facecolor='pink', alpha=0.7))\\n\\nplt.tight_layout()\\nplt.show()\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*70)\\nprint(\\\"RECONCILIATION\\\")\\nprint(\\\"=\\\"*70)\\nequity_k = result_2y['equity']/1000\\ninvested_k = result_2y['invested_deposit_value']/1000\\nprint(f\\\"\\\\nGross wealth difference:  ${equity_k:.1f}k - ${invested_k:.1f}k = ${gross_difference/1000:.1f}k\\\")\\nprint(f\\\"Minus extra costs paid:   ${costs_difference/1000:.1f}k\\\")\\nprint(f\\\"                          ─────────\\\")\\nprint(f\\\"Net benefit:              ${result_2y['wealth_difference']/1000:.1f}k\\\")\\nprint(f\\\"\\\\n✓ Your equity is ${gross_difference/1000:.1f}k higher\\\")\\nprint(f\\\"✓ But you paid ${costs_difference/1000:.1f}k extra to get it\\\")\\nprint(f\\\"✓ Net profit: ${result_2y['wealth_difference']/1000:.1f}k\\\")\",\"internalMetadata\":{\"executionOrder\":7,\"executionId\":\"77575c39-7343-4b05-a120-2d5ebb4819f4\",\"runStartTime\":1762136321049,\"runEndTime\":1762136321813,\"lastRunSuccess\":true,\"renderDuration\":{\"jupyter-notebook-renderer\":3,\"vscode.builtin-renderer\":1},\"runStartTimeAdjustment\":0,\"internalId\":\"c74546a6\"}},{\"cellKind\":1,\"language\":\"markdown\",\"metadata\":{\"metadata\":{},\"id\":\"5a201d46\"},\"outputs\":[],\"source\":\"## Compounding: Repeating the 2-Year Strategy\\n\\nAfter 2 years, you have MORE capital to reinvest:\\n- **Rent scenario:** ${result_2y['invested_deposit_value']:,.0f}\\n- **Buy scenario:** ${result_2y['equity']:,.0f}\\n\\nThis advantage compounds if you repeat the strategy!\",\"internalMetadata\":{\"internalId\":\"77ab08d9\"}},{\"cellKind\":2,\"language\":\"python\",\"metadata\":{\"execution_count\":7,\"metadata\":{},\"id\":\"e8cb2700\"},\"outputs\":[{\"outputId\":\"ad45e0d6-5165-4f57-b5cf-90423afbce75\",\"metadata\":{\"outputType\":\"stream\"},\"outputs\":[{\"data\":{\"type\":\"ArrayBuffer-4f56482b-5a03-49ba-8356-210d3b0c1c3d\",\"data\":\"\"},\"mime\":\"application/vnd.code.notebook.stdout\"}]}],\"source\":\"# Simulate repeating the 2-year buy-sell strategy\\ndef simulate_repeated_strategy(num_cycles):\\n    \\\"\\\"\\\"Simulate repeating the 2-year buy-sell strategy multiple times.\\\"\\\"\\\"\\n    results = []\\n    \\n    rent_capital = deposit\\n    buy_capital = deposit\\n    \\n    for cycle in range(1, num_cycles + 1):\\n        years = cycle * 2\\n        \\n        # RENT: Compound investment and pay rent\\n        rent_capital_end = rent_capital * (1 + investment_return_rate) ** 2\\n        rent_paid = monthly_rent * 24\\n        rent_capital = rent_capital_end - rent_paid\\n        \\n        # BUY: Scale loan to maintain same LVR\\n        lvr = P / property_price\\n        scaled_property_price = buy_capital / (1 - lvr)\\n        scaled_loan = scaled_property_price * lvr\\n        \\n        # Calculate 