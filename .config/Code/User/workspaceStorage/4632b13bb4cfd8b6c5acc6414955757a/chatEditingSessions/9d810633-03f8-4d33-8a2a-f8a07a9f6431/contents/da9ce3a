# Simple test for Harry's keyboard layout macron functionality
echo "=== Testing Harry's Keyboard Layout ==="
echo ""
echo "Current layout: $(setxkbmap -query 2>/dev/null | grep layout || echo 'Unable to detect')"
echo ""
echo "🔤 Macron Test Instructions:"
echo "Try typing the following with Alt key held:"
echo ""
echo "Alt + a should produce: ā"
