#!/bin/bash

# Test script for different Alt key configurations
echo "=== Testing Different Alt Key Configurations ==="
echo ""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

test_layout() {
    local layout_file="$1"
    local description="$2"
    
    echo "Testing: $description"
    echo "File: $layout_file"
    
    if [[ ! -f "$layout_file" ]]; then
        echo "❌ File not found: $layout_file"
        return 1
    fi
    
    # Copy to system and test
    sudo cp "$layout_file" /usr/share/X11/xkb/symbols/hb
    sudo rm -rf /var/lib/xkb/* 2>/dev/null || true
    
    if setxkbmap -layout hb 2>/dev/null; then
        echo "✅ Layout loaded successfully"
        echo "Current: $(setxkbmap -query 2>/dev/null | grep layout || echo 'Unknown')"
        echo ""
        echo "Test macrons now:"
        echo "Try Alt + a for ā, Alt + e for ē, etc."
        echo ""
        read -p "Does this Alt configuration work? (y/n): " works
        if [[ "$works" =~ ^[Yy]$ ]]; then
            echo "✅ This configuration works!"
            return 0
        else
            echo "❌ This configuration doesn't work"
            return 1
        fi
    else
        echo "❌ Failed to load layout"
        return 1
    fi
}

echo "We'll test different Alt key configurations:"
echo "1. Left Alt only (lalt_switch)"
echo "2. Right Alt only (ralt_switch)" 
echo "3. Either Alt (alt_switch - current)"
echo ""

# Test Left Alt
echo "=== Test 1: Left Alt Only ==="
if test_layout "$SCRIPT_DIR/hb_lalt" "Left Alt only (lalt_switch)"; then
    echo "Left Alt configuration works! Updating main file..."
    cp "$SCRIPT_DIR/hb_lalt" "$SCRIPT_DIR/hb"
    echo "✅ Updated hb file with Left Alt configuration"
    exit 0
fi

echo ""
echo "=== Test 2: Right Alt Only ==="
if test_layout "$SCRIPT_DIR/hb_ralt" "Right Alt only (ralt_switch)"; then
    echo "Right Alt configuration works! Updating main file..."
    cp "$SCRIPT_DIR/hb_ralt" "$SCRIPT_DIR/hb"
    echo "✅ Updated hb file with Right Alt configuration"
    exit 0
fi

echo ""
echo "=== Test 3: Either Alt (Current) ==="
if test_layout "$SCRIPT_DIR/hb" "Either Alt (alt_switch)"; then
    echo "✅ Current configuration works!"
    exit 0
fi

echo ""
echo "❌ None of the Alt configurations seem to work."
echo "This might be a keyboard hardware/driver issue."
echo ""
echo "Alternative options to try:"
echo "- Use level3(caps_switch) - Caps Lock as modifier"
echo "- Use level3(menu_switch) - Menu key as modifier"
echo "- Use level3(win_switch) - Windows key as modifier"
echo ""
echo "Would you like to try one of these alternatives?"